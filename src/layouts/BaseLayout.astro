---
import "../styles/global.css";
import { localeMeta, locales, repositoryUrl, type Locale } from "../lib/site";
interface Props { title:string; description:string; image?:string; imageAlt?:string; locale?:Locale; path?:string; forceTheme?:"dark"|"light"; localizedAlternates?:boolean }
const { title, description, image, imageAlt="MyPaaS product interface", locale="en", path=Astro.url.pathname, forceTheme, localizedAlternates=false } = Astro.props;
const canonical = Astro.site ? new URL(path, Astro.site) : Astro.url;
const socialImage = image && Astro.site ? new URL(image, Astro.site) : undefined;
const meta = localeMeta[locale];
const alternateUrls = localizedAlternates ? locales.map((item)=>({ lang:localeMeta[item].htmlLang, href:Astro.site ? new URL(localeMeta[item].path,Astro.site) : localeMeta[item].path })) : [];
const siteName = "MyPaaS";
const isHome = locales.some((item)=>localeMeta[item].path===path);
const structuredData = isHome && Astro.site ? {
  "@context":"https://schema.org",
  "@graph":[
    { "@type":"WebSite", "@id":`${new URL("/",Astro.site)}#website`, name:siteName, url:new URL("/",Astro.site).toString() },
    { "@type":"SoftwareApplication", name:siteName, applicationCategory:"DeveloperApplication", operatingSystem:"Linux", description, url:new URL("/",Astro.site).toString(), codeRepository:repositoryUrl, license:`${repositoryUrl}/blob/main/LICENSE`, isAccessibleForFree:true }
  ]
} : undefined;
---
<!doctype html>
<html lang={meta.htmlLang} class:list={{ dark: forceTheme === "dark" }}>
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="description" content={description} /><meta name="robots" content="index,follow" />
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" /><meta name="application-name" content={siteName} /><meta name="apple-mobile-web-app-title" content={siteName} />
<meta property="og:type" content="website" /><meta property="og:site_name" content={siteName} /><meta property="og:locale" content={meta.ogLocale} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
{socialImage && <meta property="og:image" content={socialImage} />}{socialImage && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />{socialImage && <meta name="twitter:image" content={socialImage} />}{socialImage && <meta name="twitter:image:alt" content={imageAlt} />}
<link rel="canonical" href={canonical} />{alternateUrls.map((item)=><link rel="alternate" hreflang={item.lang} href={item.href} />)}{localizedAlternates && Astro.site && <link rel="alternate" hreflang="x-default" href={new URL("/",Astro.site)} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.png" type="image/png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" />
<title>{title}</title>{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
<style is:global>
:root{--app-bg:#fafafa;--app-surface:#fff;--app-surface-muted:#f7f7f7;--app-surface-raised:#fff;--app-border:#e5e5e5;--app-border-strong:#d4d4d4;--app-ink:#171717;--app-muted:#525252;--app-subtle:#737373;--app-accent:#171717;--app-accent-strong:#0a0a0a;--app-accent-soft:#e5e5e5;--app-accent-ink:#171717;--font-sans:"Inter Variable","Instrument Sans Variable",system-ui,sans-serif}
:root.dark{--app-bg:#0a0a0a;--app-surface:#141414;--app-surface-muted:#1a1a1a;--app-surface-raised:#171717;--app-border:#292929;--app-border-strong:#404040;--app-ink:#fafafa;--app-muted:#a3a3a3;--app-subtle:#737373;--app-accent:#fafafa;--app-accent-strong:#fff;--app-accent-soft:#333;--app-accent-ink:#fafafa}
</style>
<script is:inline define:vars={{ forcedTheme: forceTheme ?? "" }}>(()=>{const dark=forcedTheme?forcedTheme==="dark":(()=>{const stored=localStorage.getItem("mypaas-theme");return stored==="dark"||(!stored&&matchMedia("(prefers-color-scheme: dark)").matches)})();document.documentElement.classList.toggle("dark",dark)})();</script>
</head><body><slot /></body></html>
