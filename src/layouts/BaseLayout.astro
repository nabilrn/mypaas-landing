---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import { localeMeta, locales, repositoryUrl, type Locale } from "../lib/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  locale?: Locale;
  path?: string;
  forceTheme?: "dark" | "light";
  localizedAlternates?: boolean;
  robots?: string;
}

const {
  title,
  description,
  image = "/landing/dashboard-dark.png",
  imageAlt = "MyPaaS deployment dashboard",
  locale = "en",
  path = Astro.url.pathname,
  forceTheme,
  localizedAlternates = false,
  robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1",
} = Astro.props;

const canonical = Astro.site ? new URL(path, Astro.site) : Astro.url;
const canonicalUrl = canonical.toString();
const socialImage = image && Astro.site ? new URL(image, Astro.site).toString() : image;
const meta = localeMeta[locale];
const siteName = "MyPaaS";
const rootUrl = Astro.site ? new URL("/", Astro.site).toString() : "/";
const docsUrl = Astro.site ? new URL("/docs/", Astro.site).toString() : "/docs/";
const alternateUrls = localizedAlternates
  ? locales.map((item) => ({
      lang: localeMeta[item].htmlLang,
      href: Astro.site ? new URL(localeMeta[item].path, Astro.site).toString() : localeMeta[item].path,
    }))
  : [];
const isHome = locales.some((item) => localeMeta[item].path === path);

const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${rootUrl}#website`,
    name: siteName,
    url: rootUrl,
    inLanguage: locales.map((item) => localeMeta[item].htmlLang),
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    name: title,
    description,
    url: canonicalUrl,
    inLanguage: meta.htmlLang,
    isPartOf: { "@id": `${rootUrl}#website` },
    primaryImageOfPage: socialImage ? { "@type": "ImageObject", url: socialImage } : undefined,
  },
];

if (isHome) {
  graph.push({
    "@type": "SoftwareApplication",
    "@id": `${rootUrl}#software`,
    name: siteName,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux",
    description,
    url: canonicalUrl,
    codeRepository: repositoryUrl,
    license: `${repositoryUrl}/blob/main/LICENSE`,
    softwareHelp: docsUrl,
    isAccessibleForFree: true,
  });
}

const structuredData = { "@context": "https://schema.org", "@graph": graph };
---
<!doctype html>
<html lang={meta.htmlLang} class:list={{ dark: forceTheme === "dark" }}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={robots} />
  <meta name="application-name" content={siteName} />
  <meta name="apple-mobile-web-app-title" content={siteName} />
  <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#090909" media="(prefers-color-scheme: dark)" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={meta.ogLocale} />
  {localizedAlternates && locales.filter((item) => item !== locale).map((item) => <meta property="og:locale:alternate" content={localeMeta[item].ogLocale} />)}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {socialImage && <meta property="og:image" content={socialImage} />}
  {socialImage && <meta property="og:image:secure_url" content={socialImage} />}
  {socialImage && <meta property="og:image:alt" content={imageAlt} />}

  <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}
  {socialImage && <meta name="twitter:image:alt" content={imageAlt} />}

  <link rel="canonical" href={canonicalUrl} />
  {alternateUrls.map((item) => <link rel="alternate" hreflang={item.lang} href={item.href} />)}
  {localizedAlternates && Astro.site && <link rel="alternate" hreflang="x-default" href={rootUrl} />}
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

  <link rel="icon" href="/brand/logoonly_black.png?v=3" type="image/png" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/brand/logoonly_white.png?v=3" type="image/png" media="(prefers-color-scheme: dark)" />
  <link rel="apple-touch-icon" href="/brand/logoonly_black.png?v=3" />
  <link rel="manifest" href="/site.webmanifest" />

  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script is:inline define:vars={{ forcedTheme: forceTheme ?? "" }}>(()=>{const dark=forcedTheme?forcedTheme==="dark":(()=>{const stored=localStorage.getItem("mypaas-theme");return stored==="dark"||(!stored&&matchMedia("(prefers-color-scheme: dark)").matches)})();document.documentElement.classList.toggle("dark",dark)})();</script>
</head>
<body>
  <slot />
  <CookieConsent {locale} />
</body>
</html>
