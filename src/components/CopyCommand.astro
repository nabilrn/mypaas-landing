---
interface Props { command: string; label?: string; copyLabel?: string; copiedLabel?: string; failedLabel?: string }
const { command, label = "Shell", copyLabel = "Copy", copiedLabel = "Copied", failedLabel = "Copy failed" } = Astro.props;
const hero = label === "bootstrap.sh";
---
<div class:list={["command-box", { hero }]} data-command-box data-command={command} data-copy-default={copyLabel} data-copy-success={copiedLabel} data-copy-failed={failedLabel}>
  <div class="command-meta"><span>{label}</span><button type="button" data-copy-button aria-label={copyLabel}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="10" height="10" rx="1"></rect><path d="M6 15H5a1 1 0 0 1-1-1V6a2 2 0 0 1 2-2h8a1 1 0 0 1 1 1v1"></path></svg><span data-copy-label>{copyLabel}</span></button></div>
  <pre><code>{command}</code></pre>
  <p role="status" aria-live="polite" data-copy-feedback></p>
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-command-box]:not([data-copy-ready])").forEach((box)=>{box.dataset.copyReady="true";const button=box.querySelector<HTMLButtonElement>("[data-copy-button]");const label=box.querySelector<HTMLElement>("[data-copy-label]");const feedback=box.querySelector<HTMLElement>("[data-copy-feedback]");let timer:number|undefined;button?.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(box.dataset.command??"");if(label)label.textContent=box.dataset.copySuccess||"Copied";if(feedback)feedback.textContent=box.dataset.copySuccess||"Copied";clearTimeout(timer);timer=window.setTimeout(()=>{if(label)label.textContent=box.dataset.copyDefault||"Copy";if(feedback)feedback.textContent=""},1800)}catch{if(label)label.textContent=box.dataset.copyFailed||"Copy failed";if(feedback)feedback.textContent=box.dataset.copyFailed||"Copy failed"}})})
</script>
<style>
.command-box{position:relative;overflow:hidden;border:1px solid var(--app-border-strong);background:var(--app-surface);clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px)}.command-meta{display:flex;align-items:center;justify-content:space-between;padding:.55rem .75rem;border-bottom:1px solid var(--app-border);color:var(--app-subtle);font-family:var(--font-mono);font-size:.64rem;letter-spacing:.04em;text-transform:uppercase}button{display:flex;align-items:center;gap:.35rem;padding:.3rem .5rem;border:1px solid var(--app-border);background:var(--app-bg);color:var(--app-ink);font-family:var(--font-mono);font-size:.62rem;cursor:pointer}button svg{width:.9rem;height:.9rem;fill:none;stroke:currentColor;stroke-width:1.7}button:hover{border-color:var(--app-ink)}pre{margin:0;overflow:auto;padding:1rem;color:var(--app-ink);font-size:.76rem;line-height:1.55;white-space:pre}p{min-height:.8rem;margin:.2rem .75rem .45rem;color:var(--app-subtle);font-family:var(--font-mono);font-size:.58rem}
.command-box.hero{min-height:5.2rem;border-color:#545454;background:linear-gradient(180deg,#111317,#090a0c);clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px);box-shadow:inset 0 0 0 1px rgb(255 255 255 / .025)}.command-box.hero::before{position:absolute;z-index:2;top:50%;left:1rem;transform:translateY(-50%);color:#fff;content:">_";font-family:var(--font-mono);font-size:1.05rem;font-weight:600}.hero .command-meta{position:absolute;z-index:4;inset:0 0 auto auto;padding:1rem;border:0}.hero .command-meta>span{display:none}.hero button{width:2.35rem;height:2.35rem;padding:0;border-color:#3a414b;border-radius:.45rem;background:#12151a;place-content:center}.hero button svg{width:1.05rem;height:1.05rem}.hero button [data-copy-label]{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.hero pre{padding:1.55rem 4.2rem 1.45rem 3.4rem;color:#f5f5f5;font-size:.86rem;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere}.hero p{position:absolute;left:3.4rem;bottom:.15rem;margin:0;color:#8f8f8f}
@media(max-width:600px){pre{font-size:.7rem}.hero pre{padding:1.4rem 3.8rem 1.35rem 3rem;font-size:.72rem}.command-box.hero::before{left:.85rem;font-size:.9rem}.hero .command-meta{padding:.8rem}.hero button{width:2rem;height:2rem}}
</style>