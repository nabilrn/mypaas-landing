---
interface Props { command: string; label?: string; copyLabel?: string; copiedLabel?: string; failedLabel?: string }
const { command, label = "Shell", copyLabel = "Copy", copiedLabel = "Copied", failedLabel = "Copy failed" } = Astro.props;
---
<div class="command-box" data-command-box data-command={command} data-copy-default={copyLabel} data-copy-success={copiedLabel} data-copy-failed={failedLabel}>
  <div class="command-meta"><span>{label}</span><button type="button" data-copy-button><span data-copy-label>{copyLabel}</span></button></div>
  <pre><code>{command}</code></pre>
  <p role="status" aria-live="polite" data-copy-feedback></p>
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-command-box]:not([data-copy-ready])").forEach((box)=>{box.dataset.copyReady="true";const button=box.querySelector<HTMLButtonElement>("[data-copy-button]");const label=box.querySelector<HTMLElement>("[data-copy-label]");const feedback=box.querySelector<HTMLElement>("[data-copy-feedback]");let timer:number|undefined;button?.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(box.dataset.command??"");if(label)label.textContent=box.dataset.copySuccess||"Copied";if(feedback)feedback.textContent=box.dataset.copySuccess||"Copied";clearTimeout(timer);timer=window.setTimeout(()=>{if(label)label.textContent=box.dataset.copyDefault||"Copy";if(feedback)feedback.textContent=""},1800)}catch{if(label)label.textContent=box.dataset.copyFailed||"Copy failed";if(feedback)feedback.textContent=box.dataset.copyFailed||"Copy failed"}})})
</script>
<style>
.command-box{position:relative;overflow:hidden;border:1px solid var(--app-border-strong);background:var(--app-surface);clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px)}.command-meta{display:flex;align-items:center;justify-content:space-between;padding:.55rem .75rem;border-bottom:1px solid var(--app-border);color:var(--app-subtle);font-family:var(--font-mono);font-size:.64rem;letter-spacing:.04em;text-transform:uppercase}button{padding:.3rem .5rem;border:1px solid var(--app-border);background:var(--app-bg);color:var(--app-ink);font-family:var(--font-mono);font-size:.62rem;cursor:pointer}button:hover{border-color:var(--app-ink)}pre{margin:0;overflow:auto;padding:1rem;color:var(--app-ink);font-size:.76rem;line-height:1.55;white-space:pre}p{min-height:.8rem;margin:.2rem .75rem .45rem;color:var(--app-subtle);font-family:var(--font-mono);font-size:.58rem}@media(max-width:600px){pre{font-size:.7rem}}
</style>