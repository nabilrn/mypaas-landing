<div class="hero-art" aria-hidden="true">
  <img class="hero-grid" src="/brand/hero/hero-grid.svg" alt="" />
  <img class="hero-cube" src="/brand/hero/hero-cube.svg" alt="" />
  <span class="micro source">SOURCE</span>
  <span class="micro deploy">DEPLOY</span>
  <span class="micro route">ROUTE</span>
</div>

<style>
.hero-art{position:relative;min-height:38rem;overflow:hidden;background:#050505;isolation:isolate}
.hero-grid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:68% center}
.hero-cube{position:absolute;z-index:2;top:50%;left:62%;width:min(68%,31rem);height:auto;transform:translate(-50%,-50%);filter:drop-shadow(0 0 24px rgb(255 255 255 / .035))}
