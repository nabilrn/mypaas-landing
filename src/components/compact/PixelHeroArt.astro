<div class="pixel-stage" aria-hidden="true">
  <div class="pixel-grid"></div>
  <div class="cluster cluster-a"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="cluster cluster-b"><i></i><i></i><i></i><i></i><i></i></div>
  <div class="cluster cluster-c"><i></i><i></i><i></i><i></i></div>
  <div class="route route-a"></div>
