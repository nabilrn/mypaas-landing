<style>
.pixel-stage{position:relative;min-height:28rem;overflow:hidden;border:1px solid var(--app-border-strong);background:var(--app-surface);isolation:isolate}.pixel-grid{position:absolute;inset:0;background-image:linear-gradient(var(--app-border) 1px,transparent 1px),linear-gradient(90deg,var(--app-border) 1px,transparent 1px);background-size:32px 32px;opacity:.72}.pixel-stage::before{position:absolute;inset:2rem;content:"";border:1px solid var(--app-border);clip-path:polygon(0 0,74% 0,74% 7%,100% 7%,100% 77%,94% 77%,94% 100%,18% 100%,18% 94%,0 94%)}.pixel-stage::after{position:absolute;left:12%;bottom:16%;width:76%;height:1px;background:var(--app-border-strong);content:""}.pixel-stage img{position:absolute;z-index:4;top:50%;left:50%;width:min(46%,12.5rem);height:auto;transform:translate(-50%,-50%);filter:none;image-rendering:auto}.cluster{position:absolute;z-index:2;display:grid;grid-template-columns:repeat(4,16px);grid-auto-rows:16px;gap:0}.cluster i{display:block;background:var(--app-ink)}.cluster-a{top:2rem;left:2rem}.cluster-a i:nth-child(2),.cluster-a i:nth-child(5){background:transparent;border:1px solid var(--app-border-strong)}.cluster-a i:nth-child(4){grid-column:1}.cluster-b{right:2rem;bottom:2rem;grid-template-columns:repeat(3,20px);grid-auto-rows:20px}.cluster-b i:nth-child(1),.cluster-b i:nth-child(4){background:transparent;border:1px solid var(--app-ink)}.cluster-b i:nth-child(5){grid-column:3}.cluster-c{right:16%;top:20%;grid-template-columns:repeat(2,10px);grid-auto-rows:10px}.cluster-c i:nth-child(2),.cluster-c i:nth-child(3){background:transparent;border:1px solid var(--app-border-strong)}.route{position:absolute;z-index:1;border-color:var(--app-border-strong)}.route-a{left:4rem;top:31%;width:25%;height:19%;border-left:1px solid;border-bottom:1px solid}.route-a::after{position:absolute;right:-4px;bottom:-4px;width:8px;height:8px;background:var(--app-ink);content:""}.route-b{right:4rem;top:20%;width:19%;height:31%;border-right:1px solid;border-bottom:1px solid}.route-b::before{position:absolute;left:-4px;bottom:-4px;width:8px;height:8px;border:1px solid var(--app-ink);background:var(--app-surface);content:""}.corner{position:absolute;z-index:3;width:42px;height:42px}.corner-a{top:-1px;right:-1px;border-top:6px solid var(--app-ink);border-right:6px solid var(--app-ink)}.corner-b{left:-1px;bottom:-1px;border-left:6px solid var(--app-ink);border-bottom:6px solid var(--app-ink)}.micro{position:absolute;z-index:3;padding:.22rem .34rem;border:1px solid var(--app-border-strong);background:var(--app-surface);color:var(--app-subtle);font-family:var(--font-mono);font-size:.64rem;letter-spacing:.06em}.micro-a{left:12%;bottom:9%}.micro-b{left:43%;top:10%}.micro-c{right:11%;bottom:27%}:global(.dark) .pixel-stage img{filter:invert(1)}
@media(max-width:900px){.pixel-stage{min-height:22rem}.pixel-stage img{width:min(36%,10rem)}}
@media(max-width:560px){.pixel-stage{min-height:18rem}.pixel-stage::before{inset:1rem}.cluster-a{top:1rem;left:1rem}.cluster-b{right:1rem;bottom:1rem}.route-a{left:2rem}.route-b{right:2rem}.micro{font-size:.57rem}.micro-b{left:38%}}
</style>
