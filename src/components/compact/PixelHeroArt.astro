.micro{position:absolute;z-index:4;color:rgb(255 255 255 / .4);font-family:var(--font-mono);font-size:.56rem;letter-spacing:.12em;text-transform:uppercase}
.source{top:17%;left:9%}.deploy{top:46%;right:7%}.route{bottom:10%;left:10%}
