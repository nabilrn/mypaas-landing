---
import { Image } from "astro:assets";
---
<div class="hero-art" aria-hidden="true">
  <div class="hero-logo-stage">
    <Image class="hero-logo hero-logo-haze" src="/brand/logoonly_white.png" alt="" width={64} height={64} />
    <Image class="hero-logo hero-logo-wire" src="/brand/logoonly_white.png" alt="" width={64} height={64} />
  </div>
</div>

<style>
:global(.hero-shell){background:transparent!important;color:#fff!important}
:global(.hero){position:relative;display:block!important;width:min(100%,90rem)!important;min-height:570px!important;margin:0 auto!important;isolation:isolate;overflow:hidden}
:global(.hero-copy){position:relative;z-index:5;width:688px;max-width:calc(100% - 2rem);padding:48px 0 0 54px!important}
:global(.hero .eyebrow){margin:0!important;color:#fff!important;font-family:var(--font-mono)!important;font-size:16px!important;font-weight:400!important;line-height:24px!important;letter-spacing:.02em!important;text-transform:none!important;white-space:nowrap}
:global(.hero h1){width:634px!important;max-width:100%!important;margin:8px 0 0!important;color:#fff!important;font-family:var(--font-heading)!important;font-size:58px!important;font-weight:400!important;line-height:64px!important;letter-spacing:-.01em!important;text-wrap:wrap!important}
:global(.hero .intro){width:502px!important;max-width:100%!important;margin:8px 0 0!important;color:#f5f5f5!important;font-family:var(--font-sans)!important;font-size:17px!important;font-weight:400!important;line-height:25px!important;letter-spacing:-.025em!important}
:global(.hero-install){width:594.5px!important;max-width:100%!important;margin-top:22px!important;padding:0!important;border:0!important;background:transparent!important}
:global(.hero .install-head),:global(.hero .actions){display:none!important}

:global(.hero-install .command-box.hero){width:594.5px!important;max-width:100%!important;height:76px!important;min-height:76px!important;overflow:hidden!important;border:1px solid #505054!important;background:linear-gradient(180deg,rgb(10 10 12 / .86),rgb(3 3 5 / .92))!important;box-shadow:inset 0 1px 0 rgb(255 255 255 / .035),0 8px 28px rgb(0 0 0 / .14)!important;clip-path:polygon(8px 0,calc(100% - 8px) 0,calc(100% - 8px) 8px,100% 8px,100% calc(100% - 8px),calc(100% - 8px) calc(100% - 8px),calc(100% - 8px) 100%,8px 100%,8px calc(100% - 8px),0 calc(100% - 8px),0 8px,8px 8px)!important}
:global(.hero-install .command-box.hero)::before{display:block!important;position:absolute!important;z-index:4!important;top:14px!important;left:18px!important;transform:none!important;color:#f5f5f5!important;content:">_"!important;font-family:var(--font-mono)!important;font-size:15px!important;font-weight:500!important;line-height:22px!important}
:global(.hero-install .command-meta){display:block!important;position:absolute!important;z-index:8!important;top:50%!important;right:12px!important;bottom:auto!important;left:auto!important;transform:translateY(-50%)!important;padding:0!important;border:0!important;background:transparent!important}
:global(.hero-install .command-meta>span),:global(.hero-install .command-box.hero > p){display:none!important}
:global(.hero-install .command-meta button){display:grid!important;width:32px!important;height:32px!important;padding:0!important;border:1px solid #3b3b42!important;border-radius:6px!important;background:rgb(13 13 16 / .86)!important;color:#d7d7dc!important;box-shadow:0 2px 10px rgb(0 0 0 / .28)!important;place-items:center!important}
:global(.hero-install .command-meta button:hover){border-color:#777780!important;color:#fff!important;background:rgb(23 23 28 / .9)!important}
:global(.hero-install .command-meta button[data-copy-state="copied"]){border-color:#bdbdc5!important;color:#fff!important;background:rgb(21 21 25 / .9)!important}
:global(.hero-install .command-meta button svg){width:16px!important;height:16px!important;stroke-width:1.65!important}
:global(.hero-install .command-box.hero pre){position:relative!important;z-index:3!important;width:100%!important;min-height:76px!important;margin:0!important;overflow:hidden!important;padding:12px 58px 10px 54px!important;color:#f7f7f7!important;font-family:var(--font-mono)!important;font-size:15px!important;font-weight:400!important;line-height:24px!important;letter-spacing:0!important;white-space:pre-wrap!important}

:global(.hero .runtime-badges){display:flex!important;flex-wrap:wrap!important;gap:10px!important;margin-top:12px!important}
:global(.hero .runtime-badges > span){display:flex!important;min-height:34px!important;align-items:center!important;gap:8px!important;padding:6px 11px!important;border:1px solid #34343a!important;border-radius:8px!important;background:rgb(9 9 11 / .82)!important;color:#d8d8dc!important;font-family:var(--font-sans)!important;font-size:12px!important;font-weight:520!important;line-height:18px!important;white-space:nowrap!important;backdrop-filter:blur(3px)}
:global(.hero .runtime-badges > span:nth-child(1)){order:1;padding-left:7px!important}
:global(.hero .runtime-badges > span:nth-child(2)){order:3}
:global(.hero .runtime-badges > span:nth-child(3)){order:2}
:global(.hero .runtime-badges > span > svg){width:17px!important;height:17px!important;flex:none!important;fill:currentColor!important}

.hero-art{position:absolute;z-index:1;inset:0;overflow:hidden;background:transparent;pointer-events:none}
.hero-art::before{position:absolute;z-index:2;inset:0;background:linear-gradient(180deg,rgb(255 255 255 / .008),transparent 28% 74%,rgb(0 0 0 / .18));content:""}
.hero-logo-stage{position:absolute;z-index:4;top:10%;left:64.5%;display:grid;width:27%;aspect-ratio:1;place-items:center;mix-blend-mode:screen}
.hero-logo-stage::before{position:absolute;inset:-18%;border-radius:50%;background:radial-gradient(circle,rgb(214 214 224 / .12) 0%,rgb(190 190 202 / .065) 34%,transparent 69%);filter:blur(20px);content:""}
.hero-logo{grid-area:1/1;width:100%;height:auto;max-width:none;object-fit:contain;transform-origin:center}
.hero-logo-haze{opacity:.13;filter:blur(8px) drop-shadow(0 0 34px rgb(255 255 255 / .16));transform:scale(1.045)}
.hero-logo-wire{opacity:.42;filter:contrast(.96) brightness(1.08) drop-shadow(0 0 1px rgb(255 255 255 / .36)) drop-shadow(0 0 18px rgb(255 255 255 / .08))}
.hero-art::after{position:absolute;z-index:3;inset:0;background:linear-gradient(90deg,rgb(0 0 2 / .94) 0%,rgb(0 0 2 / .9) 27%,rgb(0 0 2 / .72) 39%,rgb(0 0 2 / .42) 50%,rgb(0 0 2 / .08) 63%,transparent 74%);content:""}

@media(max-width:1100px){
  :global(.hero){min-height:590px!important}
  :global(.hero-copy){width:56%;padding:44px 0 0 32px!important}
  :global(.hero h1){font-size:50px!important;line-height:56px!important}
  :global(.hero .intro){font-size:16px!important;line-height:24px!important}
  :global(.hero-install){width:520px!important}
  :global(.hero-install .command-box.hero){width:520px!important}
  :global(.hero-install .command-box.hero pre){font-size:14px!important;line-height:23px!important}
  :global(.hero .runtime-badges){gap:7px!important}
  :global(.hero .runtime-badges > span){padding-inline:9px!important;font-size:11px!important}
  .hero-logo-stage{top:12%;left:65.5%;width:27.5%}
}
@media(max-width:900px){
  :global(.hero){min-height:700px!important}
  :global(.hero-copy){width:min(100%,640px);max-width:100%;padding:44px 32px 0!important}
  :global(.hero .eyebrow){font-size:14px!important;line-height:22px!important}
  :global(.hero h1){width:590px!important;margin-top:10px!important;font-size:48px!important;line-height:54px!important}
  :global(.hero .intro){width:520px!important;margin-top:12px!important;font-size:16px!important;line-height:24px!important}
  :global(.hero-install){width:520px!important;margin-top:22px!important}
  :global(.hero-install .command-box.hero){width:520px!important}
  :global(.hero-install .command-box.hero pre){font-size:14px!important;line-height:23px!important;padding-left:50px!important}
  .hero-art::after{background:linear-gradient(180deg,rgb(0 0 2 / .94) 0%,rgb(0 0 2 / .84) 38%,rgb(0 0 2 / .3) 68%,transparent 100%)}
  .hero-logo-stage{top:55%;right:7%;left:auto;width:min(31%,245px)}
}
@media(max-width:560px){
  :global(.hero){min-height:710px!important}
  :global(.hero-copy){padding:36px 20px 0!important}
  :global(.hero .eyebrow){font-size:12px!important;line-height:20px!important;white-space:normal}
  :global(.hero h1){font-size:40px!important;line-height:45px!important}
  :global(.hero .intro){font-size:15px!important;line-height:23px!important;letter-spacing:-.02em!important}
  :global(.hero-install){width:100%!important;margin-top:20px!important}
  :global(.hero-install .command-box.hero){width:100%!important;height:90px!important;min-height:90px!important}
  :global(.hero-install .command-box.hero pre){min-height:90px!important;padding:10px 48px 10px 44px!important;font-size:12.5px!important;line-height:21px!important;overflow-wrap:anywhere!important}
  :global(.hero-install .command-box.hero)::before{top:11px!important;left:13px!important;font-size:13px!important}
  :global(.hero-install .command-meta){right:8px!important}
  :global(.hero-install .command-meta button){width:29px!important;height:29px!important}
  :global(.hero .runtime-badges){gap:7px!important;margin-top:10px!important}
  :global(.hero .runtime-badges > span){min-height:31px!important;padding:5px 8px!important;font-size:10.5px!important}
  .hero-logo-stage{top:65%;right:3%;width:min(43%,215px)}
  .hero-logo-wire{opacity:.34}
  .hero-logo-haze{opacity:.10}
}
</style>
