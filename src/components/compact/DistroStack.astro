---
import { siDebian, siUbuntu } from "simple-icons";
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<span class:list={["distro-stack", { compact }]} aria-hidden="true">
  <span class="distro-mark ubuntu"><svg viewBox="0 0 24 24"><path d={siUbuntu.path}/></svg></span>
  <span class="distro-mark debian"><svg viewBox="0 0 24 24"><path d={siDebian.path}/></svg></span>
</span>

<style>
.distro-stack{position:relative;display:inline-block;width:31px;height:22px;flex:none}.distro-mark{position:absolute;top:1px;display:grid;width:20px;height:20px;padding:3px;border:1px solid #d8d8d8;border-radius:999px;background:#fff;place-items:center}.distro-mark svg{width:13px;height:13px}.ubuntu{left:0;z-index:2}.ubuntu svg{fill:#e95420}.debian{left:11px;z-index:3}.debian svg{fill:#a81d33}.compact{width:27px;height:20px}.compact .distro-mark{width:18px;height:18px;padding:3px}.compact .distro-mark svg{width:11px;height:11px}.compact .debian{left:9px}
</style>