---
import { siCaddy, siCloudflare, siDocker, siGithub, siPodman, siPostgresql } from "simple-icons";
import AgentRobotIcon from "./AgentRobotIcon.astro";
import InterfaceIcon from "./InterfaceIcon.astro";
import type { Locale } from "../../lib/site";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;

const content = {
  en: {
    kicker: "ARCHITECTURE",
    title: "Your infrastructure.\nOrchestrated.",
    body: "MyPaaS coordinates deployment state, runtime control, routing, data, and telemetry on one Linux host without hiding the underlying tools.",
    deployFlow: "DEPLOYMENT PATH",
    source: "Git / OCI source",
    control: "MyPaaS\nControl Plane",
    runtime: "Podman default\nDocker compatibility",
    routeFlow: "PUBLIC ROUTE",
    internet: "Internet",
    tunnel: "Cloudflare\nTunnel",
    caddy: "Caddy",
    routed: "Routed workload",
    services: "PLATFORM SERVICES",
    postgres: "PostgreSQL\nControl data",
    statd: "mypaas-statd\nOptional telemetry",
    interfaces: "OPERATOR INTERFACES",
    aria: "Deployment sources feed the MyPaaS control plane. On fresh supported hosts, the control plane uses rootful Podman by default through its Docker-compatible command and socket contract; Docker Engine remains an explicit compatibility mode. Public traffic flows from the internet through Cloudflare Tunnel and Caddy to explicitly routed workloads. PostgreSQL stores control-plane data and optional mypaas-statd provides telemetry. Operators use the Dashboard, CLI, REST API, or MCP interface.",
  },
  id: {
    kicker: "ARSITEKTUR",
    title: "Infrastruktur Anda.\nTerorkestrasi.",
    body: "MyPaaS mengoordinasikan deployment state, runtime control, routing, data, dan telemetry pada satu host Linux tanpa menyembunyikan tool yang menjadi fondasinya.",
    deployFlow: "JALUR DEPLOYMENT",
    source: "Source Git / OCI",
    control: "MyPaaS\nControl Plane",
    runtime: "Podman default\nDocker compatibility",
    routeFlow: "JALUR PUBLIK",
    internet: "Internet",
    tunnel: "Cloudflare\nTunnel",
    caddy: "Caddy",
    routed: "Workload ter-route",
    services: "LAYANAN PLATFORM",
    postgres: "PostgreSQL\nData control plane",
    statd: "mypaas-statd\nTelemetry opsional",
    interfaces: "INTERFACE OPERATOR",
    aria: "Source deployment masuk ke MyPaaS control plane. Pada fresh host yang didukung, control plane menggunakan rootful Podman sebagai default melalui contract command dan socket yang kompatibel Docker; Docker Engine tetap tersedia sebagai mode kompatibilitas eksplisit. Traffic publik berjalan dari internet melalui Cloudflare Tunnel dan Caddy ke workload yang secara eksplisit di-route. PostgreSQL menyimpan data control plane dan mypaas-statd opsional menyediakan telemetry. Operator menggunakan Dashboard, CLI, REST API, atau MCP.",
  },
  zh: {
    kicker: "架构",
    title: "你的基础设施。\n统一编排。",
    body: "MyPaaS 在单台 Linux 主机上协调部署状态、运行时控制、路由、数据与遥测，同时保留底层工具的透明性。",
    deployFlow: "部署路径",
    source: "Git / OCI 源",
    control: "MyPaaS\n控制平面",
    runtime: "Podman 默认\nDocker 兼容模式",
    routeFlow: "公网路由",
    internet: "Internet",
    tunnel: "Cloudflare\nTunnel",
    caddy: "Caddy",
    routed: "已路由工作负载",
    services: "平台服务",
    postgres: "PostgreSQL\n控制平面数据",
    statd: "mypaas-statd\n可选遥测",
    interfaces: "运维接口",
    aria: "部署源进入 MyPaaS 控制平面。在全新受支持主机上，控制平面默认通过 Docker-compatible 命令和 Socket 契约使用 Rootful Podman；Docker Engine 保留为显式兼容模式。公网流量从 Internet 经 Cloudflare Tunnel 和 Caddy 到明确路由的工作负载。PostgreSQL 保存控制平面数据，可选 mypaas-statd 提供遥测。运维人员可使用 Dashboard、CLI、REST API 或 MCP。",
  },
} as const;

const copy = content[locale];
const [titleLine1, titleLine2] = copy.title.split("\n");
const [controlLine1, controlLine2] = copy.control.split("\n");
const [runtimeLine1, runtimeLine2] = copy.runtime.split("\n");
const [tunnelLine1, tunnelLine2] = copy.tunnel.split("\n");
const [postgresLine1, postgresLine2] = copy.postgres.split("\n");
const [statdLine1, statdLine2] = copy.statd.split("\n");
---
<section class="architecture" id="architecture" aria-labelledby="architecture-title">
  <div class="architecture-inner">
    <aside class="architecture-copy">
      <div class="architecture-kicker">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 8 4.5v11L12 22l-8-4.5v-11L12 2Zm0 0v9.8m8-5.3-8 5.3-8-5.3m8 5.3V22"/></svg>
        <span>{copy.kicker}</span>
      </div>
      <h2 id="architecture-title">{titleLine1}<br />{titleLine2}</h2>
      <p>{copy.body}</p>
    </aside>

    <div class="architecture-map" role="img" aria-label={copy.aria}>
      <div class="flow-lane deployment-lane">
        <span class="flow-label">{copy.deployFlow}</span>
        <div class="diagram-frame source-card">
          <span class="dual-icons" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={siGithub.path}/></svg><svg viewBox="0 0 24 24"><path d={siDocker.path}/></svg></span>
          <strong>{copy.source}</strong>
        </div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div class="diagram-frame control-plane"><img src="/brand/logoonly_black.png" alt="" /><div><span>{controlLine1}</span><strong>{controlLine2}</strong></div></div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div class="diagram-frame runtime-card">
          <span class="dual-icons" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={siPodman.path}/></svg><svg viewBox="0 0 24 24"><path d={siDocker.path}/></svg></span>
          <strong>{runtimeLine1}<small>{runtimeLine2}</small></strong>
        </div>
      </div>

      <div class="flow-lane route-lane">
        <span class="flow-label">{copy.routeFlow}</span>
        <div class="diagram-frame plain-card"><strong>{copy.internet}</strong></div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div class="diagram-frame"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siCloudflare.path}/></svg><strong>{tunnelLine1}<small>{tunnelLine2}</small></strong></div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div class="diagram-frame"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siCaddy.path}/></svg><strong>{copy.caddy}</strong></div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div class="diagram-frame routed-card"><strong>{copy.routed}</strong></div>
      </div>

      <div class="service-band">
        <span class="flow-label">{copy.services}</span>
        <div class="diagram-frame service-card"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siPostgresql.path}/></svg><strong>{postgresLine1}<small>{postgresLine2}</small></strong></div>
        <div class="diagram-frame service-card"><span class="metric-bars" aria-hidden="true"><i></i><i></i><i></i></span><strong>{statdLine1}<small>{statdLine2}</small></strong></div>
      </div>

      <div class="interfaces-box">
        <div class="interfaces-label"><strong>{copy.interfaces}</strong><span>→ MyPaaS</span></div>
        <div class="interface-card"><InterfaceIcon name="dashboard" /><strong>Dashboard<small>Web UI</small></strong></div>
        <div class="interface-card"><InterfaceIcon name="terminal" /><strong>CLI<small>Terminal</small></strong></div>
        <div class="interface-card"><InterfaceIcon name="api" /><strong>API<small>REST</small></strong></div>
        <div class="interface-card"><AgentRobotIcon size={24} strokeWidth={1.6} /><strong>MCP<small>Agent interface</small></strong></div>
      </div>
    </div>
  </div>
</section>

<style>
.architecture{position:relative;padding:0 20px var(--landing-panel-gap);background:#fff;color:#111}.architecture::before{position:absolute;inset:0;background-image:linear-gradient(rgb(0 0 0 / .018) 1px,transparent 1px),linear-gradient(90deg,rgb(0 0 0 / .018) 1px,transparent 1px);background-size:26px 26px;mask-image:linear-gradient(90deg,transparent 0,#000 20%,#000 100%);content:"";pointer-events:none}.architecture-inner{position:relative;z-index:1;display:grid;grid-template-columns:238px minmax(0,1fr);gap:34px;width:min(calc(100% - 12px),86.5rem);margin:0 auto;padding:var(--landing-panel-padding);border:1px solid #ddd;background:#fff}.architecture-copy{padding:8px 0 0}.architecture-kicker{display:flex;align-items:center;gap:9px;color:#1a1a1a;font-family:var(--font-mono);font-size:var(--landing-section-label-size);font-weight:600;letter-spacing:.08em}.architecture-kicker svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linejoin:round}.architecture-copy h2{margin:17px 0 0;color:#111;font-family:var(--font-heading);font-size:clamp(2rem,2.7vw,2.75rem);font-weight:400;line-height:1.04;letter-spacing:-.025em}.architecture-copy p{max-width:218px;margin:24px 0 0;color:#5c5c5c;font-family:var(--font-sans);font-size:var(--landing-card-body-size);line-height:1.55}.architecture-map{display:grid;gap:12px;min-width:0}.flow-lane{display:grid;grid-template-columns:116px minmax(120px,1fr) 26px minmax(170px,1.2fr) 26px minmax(150px,1fr);gap:8px;align-items:center}.route-lane{grid-template-columns:116px minmax(90px,.7fr) 24px minmax(130px,1fr) 24px minmax(115px,.85fr) 24px minmax(135px,1fr)}.flow-label{color:#595959;font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.08em}.diagram-frame{display:flex;min-width:0;min-height:58px;align-items:center;justify-content:center;gap:9px;padding:10px 12px;border:1px solid #d7d7d7;background:#fff;color:#202020}.diagram-frame strong{display:grid;color:#151515;font-family:var(--font-sans);font-size:12.5px;font-weight:650;line-height:1.12}.diagram-frame small{margin-top:3px;color:#6b6b6b;font-size:9.5px;font-weight:500}.brand-icon{width:22px;height:22px;flex:none;fill:currentColor}.dual-icons{display:flex;flex:none;align-items:center;gap:5px}.dual-icons svg{width:21px;height:21px;fill:currentColor}.control-plane{justify-content:flex-start;padding-inline:15px;border-color:#bdbdbd}.control-plane img{width:38px;height:38px;object-fit:contain}.control-plane div{display:grid}.control-plane span{font-family:var(--font-sans);font-size:11px;font-weight:600}.control-plane strong{font-size:14px}.flow-arrow{color:#555;text-align:center;font-family:var(--font-mono);font-size:17px}.service-band{display:grid;grid-template-columns:116px 1fr 1fr;gap:8px;align-items:center}.service-card{justify-content:flex-start}.metric-bars{display:flex;align-items:flex-end;gap:3px;width:22px;height:22px}.metric-bars i{display:block;width:3px;background:#1b1b1b}.metric-bars i:first-child{height:7px}.metric-bars i:nth-child(2){height:13px}.metric-bars i:last-child{height:20px}.interfaces-box{display:grid;grid-template-columns:1.15fr repeat(4,1fr);gap:8px;align-items:center;padding:9px 10px;border:1px dashed #a7a7a7;background:#fff}.interfaces-label{display:grid;padding-left:4px;color:#202020;font-family:var(--font-mono);font-size:10px;line-height:1.15}.interfaces-label span{margin-top:3px;color:#6b6b6b;font-weight:500}.interface-card{display:flex;min-width:0;height:50px;align-items:center;gap:8px;padding:0 11px;border:1px solid #e0e0e0;background:#fff;color:#181818}.interface-card strong{display:grid;color:#181818;font-family:var(--font-sans);font-size:12px;line-height:1.05}.interface-card small{margin-top:3px;color:#6b6b6b;font-size:9px;font-weight:500}
@media(max-width:1100px){.architecture-inner{grid-template-columns:1fr;gap:24px}.architecture-copy{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:end}.architecture-copy h2{margin-top:12px}.architecture-copy p{max-width:34rem;margin:0}.flow-lane,.route-lane{grid-template-columns:100px minmax(0,1fr) 22px minmax(0,1fr) 22px minmax(0,1fr)}.route-lane .flow-label{grid-column:1}.route-lane .routed-card{grid-column:2/-1}.route-lane .routed-card::before{content:"Caddy → ";font-family:var(--font-mono);font-size:10px;color:#666}.route-lane>.flow-arrow:nth-of-type(3),.route-lane>.diagram-frame:nth-of-type(4){display:none}.service-band{grid-template-columns:100px 1fr 1fr}}
@media(max-width:760px){.architecture{padding:0 12px var(--landing-panel-gap)}.architecture-inner{padding:20px 14px}.architecture-copy{grid-template-columns:1fr}.architecture-copy p{margin-top:2px}.flow-lane,.route-lane,.service-band{grid-template-columns:1fr;gap:7px}.flow-label{margin-top:4px}.flow-arrow{transform:rotate(90deg)}.route-lane .routed-card{grid-column:auto}.route-lane .routed-card::before{display:none}.route-lane>.flow-arrow:nth-of-type(3),.route-lane>.diagram-frame:nth-of-type(4){display:flex}.interfaces-box{grid-template-columns:1fr 1fr;gap:8px}.interfaces-label{grid-column:1/-1;padding:2px 0}.diagram-frame{min-height:54px}}
@media(max-width:480px){.architecture-copy h2{font-size:2rem}.interfaces-box{grid-template-columns:1fr}.interfaces-label{grid-column:1}.interface-card{height:50px}}
</style>