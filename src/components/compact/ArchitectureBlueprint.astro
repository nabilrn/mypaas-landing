---
import { siCaddy, siCloudflare, siDocker, siGithub, siPodman, siPostgresql } from "simple-icons";
---
<section class="architecture" id="architecture" aria-labelledby="architecture-title">
  <div class="architecture-inner">
    <aside class="architecture-copy">
      <div class="architecture-kicker">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 8 4.5v11L12 22l-8-4.5v-11L12 2Zm0 0v9.8m8-5.3-8 5.3-8-5.3m8 5.3V22"/></svg>
        <span>ARCHITECTURE</span>
      </div>
      <h2 id="architecture-title">Your infrastructure.<br />Orchestrated.</h2>
      <p>MyPaaS coordinates your apps, components, and workflows on your own server—securely and predictably.</p>
    </aside>

    <div class="architecture-map" role="img" aria-label="GitHub and Cloudflare connect to the MyPaaS control plane. The control plane coordinates Caddy, Docker or Podman runtime, PostgreSQL, and mypaas-statd, with Dashboard, CLI, API, and MCP interfaces.">
      <svg class="map-wires" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0 8 4 0 8Z" /></marker>
        </defs>
        <path class="dashed" d="M150 50H385" marker-end="url(#arrow)" />
        <path class="dashed" d="M850 50H615" marker-end="url(#arrow)" />
        <path d="M500 88V126H95V160" marker-end="url(#arrow)" />
        <path d="M500 126H365V160" marker-end="url(#arrow)" />
        <path d="M500 126H635V160" marker-end="url(#arrow)" />
        <path d="M500 126H905V160" marker-end="url(#arrow)" />
        <circle cx="500" cy="126" r="4" />
        <circle cx="365" cy="126" r="4" />
        <circle cx="635" cy="126" r="4" />
        <circle cx="905" cy="126" r="4" />
      </svg>

      <div class="source source-github diagram-frame">
        <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path}/></svg>
        <strong>GitHub</strong>
      </div>

      <div class="control-plane diagram-frame">
        <img src="/brand/logoonly_black.png" alt="" />
        <div><span>MyPaaS</span><strong>Control Plane</strong></div>
      </div>

      <div class="source source-cloudflare diagram-frame" style={`--brand:#${siCloudflare.hex}`}>
        <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siCloudflare.path}/></svg>
        <strong>Cloudflare</strong>
      </div>

      <div class="service service-caddy diagram-frame" style={`--brand:#${siCaddy.hex}`}>
        <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siCaddy.path}/></svg>
        <strong>Caddy</strong>
      </div>

      <div class="service service-runtime diagram-frame">
        <span class="dual-icons" aria-hidden="true">
          <svg class="docker" viewBox="0 0 24 24"><path d={siDocker.path}/></svg>
          <span class="podman-plate"><svg viewBox="0 0 24 24"><path d={siPodman.path}/></svg></span>
        </span>
        <strong>Docker / Podman<br />Runtime</strong>
      </div>

      <div class="service service-postgres diagram-frame" style={`--brand:#${siPostgresql.hex}`}>
        <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siPostgresql.path}/></svg>
        <strong>PostgreSQL<br />Database</strong>
      </div>

      <div class="service service-statd diagram-frame">
        <span class="metric-bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <strong>mypaas-statd<br /><small>Metrics &amp; Logs</small></strong>
      </div>

      <div class="interfaces-box">
        <div class="interfaces-label"><strong>Interfaces</strong><span>(Operator)</span></div>
        <div class="interface-card">
          <span class="dashboard-icon" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong>Dashboard<small>(Web UI)</small></strong>
        </div>
        <div class="interface-card"><span class="terminal-icon" aria-hidden="true">&gt;_</span><strong>CLI<small>(Terminal)</small></strong></div>
        <div class="interface-card"><span class="api-icon" aria-hidden="true">&lt; &gt;</span><strong>API<small>(REST)</small></strong></div>
        <div class="interface-card">
          <svg class="mcp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v3M9.5 3h5M6.5 8.5h11a2.5 2.5 0 0 1 2.5 2.5v7a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 18v-7a2.5 2.5 0 0 1 2.5-2.5Z"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/><path d="M9 17h6M2.5 12.5H4m16 0h1.5"/></svg>
          <strong>MCP<small>(Agent Interface)</small></strong>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.architecture{position:relative;padding:22px 20px 54px;background:#fff;color:#111}.architecture::before{position:absolute;inset:0;background-image:linear-gradient(rgb(0 0 0 / .024) 1px,transparent 1px),linear-gradient(90deg,rgb(0 0 0 / .024) 1px,transparent 1px);background-size:26px 26px;mask-image:linear-gradient(90deg,transparent 0,#000 22%,#000 100%);content:"";pointer-events:none}.architecture-inner{position:relative;z-index:1;display:grid;grid-template-columns:250px minmax(0,1fr);gap:38px;width:min(calc(100% - 12px),86.5rem);margin:0 auto;padding:28px 28px 24px;border:1px solid #d7d7d7;border-radius:18px;background:#fff;box-shadow:none}.architecture-copy{padding:12px 0 0}.architecture-kicker{display:flex;align-items:center;gap:9px;color:#1a1a1a;font-family:var(--font-mono);font-size:12px;font-weight:600;letter-spacing:.08em}.architecture-kicker svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linejoin:round}.architecture-copy h2{margin:18px 0 0;color:#111;font-family:var(--font-display);font-size:clamp(2rem,2.8vw,2.9rem);font-weight:600;line-height:1.03;letter-spacing:-.025em}.architecture-copy p{max-width:220px;margin:26px 0 0;color:#555;font-family:var(--font-sans);font-size:14px;line-height:1.55}.architecture-map{position:relative;display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:88px 38px 84px 18px 84px;gap:0 12px;min-height:312px}.map-wires{position:absolute;z-index:0;inset:0;width:100%;height:228px;overflow:visible}.map-wires path{fill:none;stroke:#222;stroke-width:1.35;vector-effect:non-scaling-stroke}.map-wires .dashed{stroke-dasharray:4 4}.map-wires circle{fill:#222}.map-wires marker path{fill:#222;stroke:none}.diagram-frame{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;gap:10px;border:1px solid #3d3d3a;background:#fff;clip-path:polygon(7px 0,calc(100% - 7px) 0,calc(100% - 7px) 7px,100% 7px,100% calc(100% - 7px),calc(100% - 7px) calc(100% - 7px),calc(100% - 7px) 100%,7px 100%,7px calc(100% - 7px),0 calc(100% - 7px),0 7px,7px 7px);box-shadow:none}.diagram-frame::before,.diagram-frame::after{position:absolute;width:6px;height:6px;background:#fff;content:""}.diagram-frame::before{top:-1px;left:-1px;border-right:1px solid #3d3d3a;border-bottom:1px solid #3d3d3a}.diagram-frame::after{right:-1px;bottom:-1px;border-top:1px solid #3d3d3a;border-left:1px solid #3d3d3a}.diagram-frame strong{color:#151515;font-family:var(--font-display);font-size:13px;font-weight:600;line-height:1.12}.brand-icon{width:25px;height:25px;fill:var(--brand,#111)}.source{align-self:center;height:56px}.source-github{grid-column:1/4;grid-row:1}.control-plane{grid-column:5/9;grid-row:1;height:72px;align-self:center;justify-content:flex-start;padding:0 24px}.control-plane img{width:47px;height:47px;object-fit:contain}.control-plane div{display:grid}.control-plane span{font-family:var(--font-sans);font-size:13px;font-weight:600}.control-plane strong{font-size:16px}.source-cloudflare{grid-column:10/13;grid-row:1}.service{height:56px;align-self:center}.service-caddy{grid-column:1/4;grid-row:3}.service-runtime{grid-column:4/7;grid-row:3}.service-postgres{grid-column:7/10;grid-row:3}.service-statd{grid-column:10/13;grid-row:3}.dual-icons{display:flex;align-items:center;gap:6px}.dual-icons .docker{width:25px;height:25px;fill:#2496ed}.podman-plate{display:grid;width:25px;height:25px;border:1px solid #d7d7d2;border-radius:50%;background:#fff;place-items:center}.podman-plate svg{width:17px;height:17px;fill:#892ca0}.metric-bars{display:flex;align-items:flex-end;gap:3px;width:28px;height:26px}.metric-bars i{display:block;width:5px;background:#1b1b1b}.metric-bars i:first-child{height:9px}.metric-bars i:nth-child(2){height:16px}.metric-bars i:last-child{height:24px}.service-statd small{font-size:11px;font-weight:500}.interfaces-box{grid-column:1/13;grid-row:5;display:grid;grid-template-columns:1.05fr repeat(4,1fr);gap:10px;align-items:center;padding:10px 12px;border:1px dashed #555;border-radius:9px;background:#fff}.interfaces-label{display:grid;padding-left:4px;color:#202020;font-family:var(--font-mono);font-size:12px}.interfaces-label span{font-weight:600}.interface-card{display:flex;min-width:0;height:56px;align-items:center;gap:9px;padding:0 14px;border:1px solid #dddcd7;border-radius:9px;background:#fff}.interface-card strong{display:grid;color:#181818;font-family:var(--font-sans);font-size:12px;line-height:1.05}.interface-card small{margin-top:3px;color:#666;font-size:10px;font-weight:500}.terminal-icon,.api-icon{min-width:31px;color:#171717;font-family:var(--font-mono);font-size:20px}.mcp-icon{width:29px;height:29px;fill:none;stroke:#181818;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}.dashboard-icon{position:relative;display:grid;grid-template-columns:repeat(2,7px);grid-template-rows:repeat(2,7px);gap:3px;width:26px;height:26px;padding:3px;border:1.5px solid #202020;border-radius:3px}.dashboard-icon i{border:1px solid #202020}.dashboard-icon i:last-child{grid-column:1/3}.architecture-map::after{display:none}
@media(max-width:1050px){.architecture-inner{grid-template-columns:1fr;gap:24px}.architecture-copy{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:end}.architecture-copy h2{margin-top:12px}.architecture-copy p{max-width:34rem;margin:0}.architecture-map{min-height:322px}}
@media(max-width:760px){.architecture{padding:28px 12px 34px}.architecture-inner{padding:20px 14px;border-radius:14px}.architecture-copy{grid-template-columns:1fr}.architecture-copy p{margin-top:2px}.map-wires{display:none}.architecture-map{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto;gap:10px;min-height:0}.source,.control-plane,.service{grid-column:auto!important;grid-row:auto!important;width:auto;height:64px}.control-plane{grid-column:1/-1!important;order:-1}.interfaces-box{grid-column:1/-1;grid-row:auto;grid-template-columns:1fr 1fr;gap:8px;margin-top:2px}.interfaces-label{grid-column:1/-1;padding:2px 0}.interface-card{height:52px}}
@media(max-width:480px){.architecture-copy h2{font-size:2rem}.architecture-map{grid-template-columns:1fr}.control-plane,.interfaces-box{grid-column:1!important}.interfaces-box{grid-template-columns:1fr}.interfaces-label{grid-column:1}.diagram-frame,.interface-card{min-height:58px}}
</style>
