---
import { siCaddy, siCloudflare, siDocker, siGithub, siPodman, siPostgresql } from "simple-icons";
import AgentRobotIcon from "./AgentRobotIcon.astro";
import InterfaceIcon from "./InterfaceIcon.astro";
---
<section class="architecture" id="architecture" aria-labelledby="architecture-title">
  <div class="architecture-inner">
    <aside class="architecture-copy">
      <div class="architecture-kicker">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 8 4.5v11L12 22l-8-4.5v-11L12 2Zm0 0v9.8m8-5.3-8 5.3-8-5.3m8 5.3V22"/></svg>
        <span>ARCHITECTURE</span>
      </div>
      <h2 id="architecture-title">Your infrastructure.<br />Orchestrated.</h2>
      <p>MyPaaS coordinates your apps, components, and workflows on your own server, securely and predictably.</p>
    </aside>

    <div class="architecture-map" role="img" aria-label="GitHub and Cloudflare connect to the MyPaaS control plane. The control plane coordinates Caddy, Docker or Podman runtime, PostgreSQL, and mypaas-statd, with Dashboard, CLI, API, and MCP interfaces.">
      <svg class="map-wires" viewBox="0 0 1000 292" preserveAspectRatio="none" aria-hidden="true">
        <defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto"><path d="M0 0 7 3.5 0 7Z" /></marker></defs>
        <path d="M150 46H385" marker-end="url(#arrow)" /><path d="M850 46H615" marker-end="url(#arrow)" />
        <path d="M500 82V118H95V150" marker-end="url(#arrow)" /><path d="M500 118H365V150" marker-end="url(#arrow)" /><path d="M500 118H635V150" marker-end="url(#arrow)" /><path d="M500 118H905V150" marker-end="url(#arrow)" />
        <circle cx="500" cy="118" r="3" /><circle cx="365" cy="118" r="3" /><circle cx="635" cy="118" r="3" /><circle cx="905" cy="118" r="3" />
      </svg>

      <div class="source source-github diagram-frame"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path}/></svg><strong>GitHub</strong></div>
      <div class="control-plane diagram-frame"><img src="/brand/logoonly_black.png" alt="" /><div><span>MyPaaS</span><strong>Control Plane</strong></div></div>
      <div class="source source-cloudflare diagram-frame"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siCloudflare.path}/></svg><strong>Cloudflare</strong></div>
      <div class="service service-caddy diagram-frame"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siCaddy.path}/></svg><strong>Caddy</strong></div>
      <div class="service service-runtime diagram-frame"><span class="dual-icons" aria-hidden="true"><svg class="docker" viewBox="0 0 24 24"><path d={siDocker.path}/></svg><span class="podman-plate"><svg viewBox="0 0 24 24"><path d={siPodman.path}/></svg></span></span><strong>Docker / Podman<br />Runtime</strong></div>
      <div class="service service-postgres diagram-frame"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siPostgresql.path}/></svg><strong>PostgreSQL<br />Database</strong></div>
      <div class="service service-statd diagram-frame"><span class="metric-bars" aria-hidden="true"><i></i><i></i><i></i></span><strong>mypaas-statd<br /><small>Metrics &amp; Logs</small></strong></div>

      <div class="interfaces-box">
        <div class="interfaces-label"><strong>Interfaces</strong><span>(Operator)</span></div>
        <div class="interface-card"><InterfaceIcon name="dashboard" /><strong>Dashboard<small>(Web UI)</small></strong></div>
        <div class="interface-card"><InterfaceIcon name="terminal" /><strong>CLI<small>(Terminal)</small></strong></div>
        <div class="interface-card"><InterfaceIcon name="api" /><strong>API<small>(REST)</small></strong></div>
        <div class="interface-card"><AgentRobotIcon size={24} strokeWidth={1.6} /><strong>MCP<small>(Agent Interface)</small></strong></div>
      </div>
    </div>
  </div>
</section>

<style>
.architecture{position:relative;padding:0 20px var(--landing-panel-gap);background:#fff;color:#111}.architecture::before{position:absolute;inset:0;background-image:linear-gradient(rgb(0 0 0 / .018) 1px,transparent 1px),linear-gradient(90deg,rgb(0 0 0 / .018) 1px,transparent 1px);background-size:26px 26px;mask-image:linear-gradient(90deg,transparent 0,#000 20%,#000 100%);content:"";pointer-events:none}.architecture-inner{position:relative;z-index:1;display:grid;grid-template-columns:238px minmax(0,1fr);gap:34px;width:min(calc(100% - 12px),86.5rem);margin:0 auto;padding:var(--landing-panel-padding);border:1px solid #dddddd;border-radius:var(--landing-panel-radius);background:#fff}.architecture-copy{padding:8px 0 0}.architecture-kicker{display:flex;align-items:center;gap:9px;color:#1a1a1a;font-family:var(--font-mono);font-size:var(--landing-section-label-size);font-weight:600;letter-spacing:.08em}.architecture-kicker svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linejoin:round}.architecture-copy h2{margin:17px 0 0;color:#111;font-family:var(--font-heading);font-size:clamp(2rem,2.7vw,2.75rem);font-weight:400;line-height:1.04;letter-spacing:-.025em}.architecture-copy p{max-width:218px;margin:24px 0 0;color:#5c5c5c;font-family:var(--font-sans);font-size:var(--landing-card-body-size);line-height:1.55}.architecture-map{position:relative;display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:82px 32px 72px 16px 72px;gap:0 12px;min-height:274px}.map-wires{position:absolute;z-index:0;inset:0;width:100%;height:214px;overflow:visible}.map-wires path{fill:none;stroke:#4f4f4f;stroke-width:1.05;vector-effect:non-scaling-stroke}.map-wires circle{fill:#333}.map-wires marker path{fill:#333;stroke:none}.diagram-frame{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;gap:9px;border:1px solid #d7d7d7;border-radius:9px;background:#fff;color:#202020;box-shadow:none}.diagram-frame strong{color:#151515;font-family:var(--font-sans);font-size:var(--landing-card-title-size);font-weight:650;line-height:1.12}.brand-icon{width:22px;height:22px;fill:currentColor}.source{align-self:center;height:52px}.source-github{grid-column:1/4;grid-row:1}.control-plane{grid-column:5/9;grid-row:1;height:64px;align-self:center;justify-content:flex-start;padding:0 20px;border-color:#bdbdbd}.control-plane img{width:42px;height:42px;object-fit:contain}.control-plane div{display:grid}.control-plane span{font-family:var(--font-sans);font-size:12px;font-weight:600}.control-plane strong{font-size:15px}.source-cloudflare{grid-column:10/13;grid-row:1}.service{height:52px;align-self:center}.service-caddy{grid-column:1/4;grid-row:3}.service-runtime{grid-column:4/7;grid-row:3}.service-postgres{grid-column:7/10;grid-row:3}.service-statd{grid-column:10/13;grid-row:3}.dual-icons{display:flex;align-items:center;gap:5px;color:#202020}.dual-icons .docker{width:22px;height:22px;fill:currentColor}.podman-plate{display:grid;width:22px;height:22px;border:1px solid #dedede;border-radius:50%;background:#fff;color:#202020;place-items:center}.podman-plate svg{width:15px;height:15px;fill:currentColor}.metric-bars{display:flex;align-items:flex-end;gap:3px;width:22px;height:22px}.metric-bars i{display:block;width:3px;background:#1b1b1b}.metric-bars i:first-child{height:7px}.metric-bars i:nth-child(2){height:13px}.metric-bars i:last-child{height:20px}.service-statd small{font-size:10px;font-weight:500}.interfaces-box{grid-column:1/13;grid-row:5;display:grid;grid-template-columns:1.02fr repeat(4,1fr);gap:10px;align-items:center;padding:9px 10px;border:1px dashed #a7a7a7;border-radius:10px;background:#fff}.interfaces-label{display:grid;padding-left:4px;color:#202020;font-family:var(--font-mono);font-size:12px;line-height:1.05}.interfaces-label span{font-weight:600}.interface-card{display:flex;min-width:0;height:50px;align-items:center;gap:9px;padding:0 13px;border:1px solid #e0e0e0;border-radius:9px;background:#fff;color:#181818}.interface-card strong{display:grid;color:#181818;font-family:var(--font-sans);font-size:13px;line-height:1.05}.interface-card small{margin-top:3px;color:#6b6b6b;font-size:10px;font-weight:500}
@media(max-width:1050px){.architecture-inner{grid-template-columns:1fr;gap:24px}.architecture-copy{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:end}.architecture-copy h2{margin-top:12px}.architecture-copy p{max-width:34rem;margin:0}.architecture-map{min-height:286px}}
@media(max-width:760px){.architecture{padding:0 12px var(--landing-panel-gap)}.architecture-inner{padding:20px 14px;border-radius:14px}.architecture-copy{grid-template-columns:1fr}.architecture-copy p{margin-top:2px}.map-wires{display:none}.architecture-map{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto;gap:10px;min-height:0}.source,.control-plane,.service{grid-column:auto!important;grid-row:auto!important;width:auto;height:60px}.control-plane{grid-column:1/-1!important;order:-1}.interfaces-box{grid-column:1/-1;grid-row:auto;grid-template-columns:1fr 1fr;gap:8px;margin-top:2px}.interfaces-label{grid-column:1/-1;padding:2px 0}.interface-card{height:50px}}
@media(max-width:480px){.architecture-copy h2{font-size:2rem}.architecture-map{grid-template-columns:1fr}.control-plane,.interfaces-box{grid-column:1!important}.interfaces-box{grid-template-columns:1fr}.interfaces-label{grid-column:1}.diagram-frame,.interface-card{min-height:56px}}
</style>
