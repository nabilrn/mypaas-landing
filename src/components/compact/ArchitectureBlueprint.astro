---
import { siCaddy, siCloudflare, siGithub, siGo, siLinux, siPodman, siPostgresql } from "simple-icons";
---
<section class="blueprint" aria-labelledby="architecture-title">
  <div class="blueprint-head">
    <div>
      <span class="eyebrow">ARCHITECTURE / SINGLE HOST</span>
      <h2 id="architecture-title">Your infrastructure. Orchestrated.</h2>
    </div>
    <p>GitHub feeds source into the MyPaaS control plane. Cloudflare and Caddy publish traffic. The Go API coordinates runtime state, PostgreSQL, host telemetry, and the same Dashboard, CLI, API, and MCP interfaces.</p>
  </div>

  <div class="diagram" role="img" aria-label="MyPaaS architecture with GitHub source and Cloudflare edge connected to the MyPaaS control plane, which manages Caddy, Podman-compatible runtime, PostgreSQL, mypaas-statd, and Dashboard CLI API MCP interfaces on one Linux host.">
    <div class="topology-row">
      <div class="node external" style={`--brand:#${siGithub.hex}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path}/></svg><strong>GitHub</strong><small>source · OAuth · webhooks</small></div>
      <div class="wire" aria-hidden="true"><i></i></div>
      <div class="node control"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGo.path}/></svg><div><span>MYPAAS</span><strong>Control Plane</strong><small>deploy · route · recover · automate</small></div></div>
      <div class="wire" aria-hidden="true"><i></i></div>
      <div class="node external" style={`--brand:#${siCloudflare.hex}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siCloudflare.path}/></svg><strong>Cloudflare</strong><small>Tunnel · TLS · public edge</small></div>
    </div>

    <div class="service-bus" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <div class="service-grid">
      <div class="node service" style={`--brand:#${siCaddy.hex}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siCaddy.path}/></svg><strong>Caddy</strong><small>routing · static delivery</small></div>
      <div class="node service" style={`--brand:#${siPodman.hex}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siPodman.path}/></svg><strong>Podman / Docker</strong><small>container runtime contract</small></div>
      <div class="node service" style={`--brand:#${siPostgresql.hex}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siPostgresql.path}/></svg><strong>PostgreSQL</strong><small>platform state · shared DB optional</small></div>
      <div class="node service"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span><strong>mypaas-statd</strong><small>host metrics · cgroup telemetry</small></div>
    </div>

    <div class="interfaces">
      <div class="interface-label"><span>INTERFACES</span><strong>Operator + automation</strong></div>
      <div>Dashboard<small>Web UI</small></div>
      <div>CLI<small>Terminal</small></div>
      <div>API<small>REST</small></div>
      <div class="mcp-interface">MCP<small>Agent interface</small></div>
    </div>

    <div class="host-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siLinux.path}/></svg><span>ONE LINUX HOST · VM OR BARE METAL</span></div>
  </div>
</section>

<style>
.blueprint{width:min(calc(100% - 2rem),var(--page-width));margin:0 auto;padding:2.8rem 0;border-top:1px solid var(--app-border-strong)}.blueprint-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.72fr);gap:3rem;align-items:end;margin-bottom:1.35rem}.eyebrow,.control span,.interface-label span,.host-label span{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.09em;text-transform:uppercase;color:var(--app-subtle)}h2{max-width:14ch;margin:.6rem 0 0;color:var(--app-ink);font-family:var(--font-display);font-size:clamp(2.2rem,4vw,3.7rem);font-weight:650;line-height:.98;letter-spacing:-.035em}.blueprint-head p{margin:0;color:var(--app-muted);font-size:.98rem;line-height:1.58}.diagram{position:relative;padding:1rem;border:1px solid var(--app-border-strong);background-color:var(--app-bg);background-image:linear-gradient(var(--app-border) 1px,transparent 1px),linear-gradient(90deg,var(--app-border) 1px,transparent 1px);background-size:24px 24px}.topology-row{display:grid;grid-template-columns:minmax(9rem,1fr) 4rem minmax(12rem,1.25fr) 4rem minmax(9rem,1fr);align-items:stretch}.node{background:var(--app-surface)}.external,.control{min-height:5.4rem;border:1px solid var(--app-border-strong)}.external{display:grid;grid-template-columns:auto 1fr;gap:.12rem .65rem;align-content:center;padding:.8rem}.external svg{grid-row:1/3;width:1.35rem;height:1.35rem;align-self:center;fill:var(--brand)}.external strong,.control strong,.service strong{color:var(--app-ink);font-family:var(--font-display);font-weight:650}.external strong{font-size:1rem}.external small,.control small,.service small{color:var(--app-muted);font-size:.72rem}.control{display:flex;align-items:center;justify-content:center;gap:.75rem;padding:.8rem;background:var(--app-surface)}.control svg{width:1.5rem;height:1.5rem;fill:#00add8}.control>div{display:grid;gap:.04rem}.control strong{font-size:1.05rem}.wire{position:relative}.wire::before{position:absolute;top:50%;left:.45rem;right:.45rem;height:1px;background:var(--app-border-strong);content:""}.wire i{position:absolute;top:calc(50% - 3px);left:calc(50% - 3px);width:6px;height:6px;background:var(--app-ink)}.service-bus{position:relative;display:grid;grid-template-columns:repeat(4,1fr);height:1.65rem;margin:0 7%}.service-bus::before{position:absolute;top:.78rem;left:12%;right:12%;height:1px;background:var(--app-border-strong);content:""}.service-bus i{justify-self:center;width:1px;height:100%;background:var(--app-border-strong)}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;border:1px solid var(--app-border-strong);background:var(--app-border-strong)}.service{display:grid;grid-template-columns:auto 1fr;gap:.12rem .6rem;align-content:center;min-height:6rem;padding:.8rem}.service svg{grid-row:1/3;width:1.2rem;height:1.2rem;align-self:center;fill:var(--brand)}.service strong{font-size:.92rem}.bars{grid-row:1/3;display:flex;align-items:flex-end;gap:2px;width:1.25rem;height:1.25rem;align-self:center}.bars i{width:4px;background:var(--app-ink)}.bars i:first-child{height:40%}.bars i:nth-child(2){height:68%}.bars i:last-child{height:100%}.interfaces{display:grid;grid-template-columns:1.2fr repeat(4,1fr);gap:1px;margin-top:1rem;border:1px dashed var(--app-border-strong);background:var(--app-border)}.interfaces>div{display:grid;align-content:center;min-height:4.3rem;padding:.7rem;background:var(--app-surface);color:var(--app-ink);font-size:.82rem;font-weight:650}.interfaces small{display:block;margin-top:.1rem;color:var(--app-muted);font-size:.68rem;font-weight:450}.interface-label strong{font-size:.8rem}.mcp-interface{position:relative}.mcp-interface::after{position:absolute;top:7px;right:7px;width:6px;height:6px;background:var(--app-ink);content:""}.host-label{display:flex;align-items:center;gap:.5rem;margin-top:.75rem;color:var(--app-subtle)}.host-label svg{width:1rem;height:1rem;fill:var(--app-ink)}
@media(max-width:850px){.blueprint-head{grid-template-columns:1fr;gap:.7rem}.topology-row{grid-template-columns:1fr}.wire{height:1.5rem}.wire::before{top:.2rem;bottom:.2rem;left:50%;width:1px;height:auto}.wire i{left:calc(50% - 3px)}.service-bus{display:none}.service-grid{grid-template-columns:1fr 1fr;margin-top:1rem}.interfaces{grid-template-columns:1fr 1fr}.interface-label{grid-column:1/-1}}
@media(max-width:560px){.blueprint{width:min(calc(100% - 1.25rem),var(--page-width));padding:2.2rem 0}.diagram{padding:.65rem}.service-grid,.interfaces{grid-template-columns:1fr}.interface-label{grid-column:auto}.service{min-height:4.8rem}}
</style>
