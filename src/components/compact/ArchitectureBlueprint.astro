---
import { siCaddy, siCloudflare, siDocker, siGo, siLinux, siPostgresql } from "simple-icons";

const icon = (path: string) => path;
---
<section class="blueprint" aria-labelledby="architecture-title">
  <div class="blueprint-head">
    <div>
      <span class="eyebrow">ARCHITECTURE / SINGLE HOST</span>
      <h2 id="architecture-title">One Linux host. Clear control and data paths.</h2>
    </div>
    <p>Cloudflare and Caddy handle ingress. The Go control plane manages state, runtime actions, telemetry, and project routing.</p>
  </div>

  <div class="diagram" role="img" aria-label="MyPaaS architecture: Internet through Cloudflare Tunnel and Caddy to dashboard, API, containers, and static releases. The Go API connects to PostgreSQL, Docker-compatible runtime, and mypaas-statd on the Linux host.">
    <div class="lane ingress">
      <div class="node icon-node">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(siCloudflare.path)} /></svg>
        <span>Cloudflare Tunnel</span>
      </div>
      <div class="wire horizontal"><i></i></div>
      <div class="node icon-node">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(siCaddy.path)} /></svg>
        <span>Caddy</span>
      </div>
    </div>

    <div class="bus" aria-hidden="true"><i></i><i></i><i></i></div>

    <div class="lane control">
      <div class="node panel">
        <span class="node-kicker">UI</span>
        <strong>Dashboard</strong>
        <small>SvelteKit operator surface</small>
      </div>
      <div class="node panel primary">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(siGo.path)} /></svg>
        <span class="node-kicker">CONTROL</span>
        <strong>Go API</strong>
        <small>deploy · route · recover · automate</small>
      </div>
      <div class="node panel">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(siPostgresql.path)} /></svg>
        <span class="node-kicker">STATE</span>
        <strong>PostgreSQL</strong>
        <small>platform + optional shared DB</small>
      </div>
    </div>

    <div class="host-shell">
      <div class="host-title">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(siLinux.path)} /></svg>
        <div><span>LINUX HOST</span><strong>single VM / bare-metal host</strong></div>
      </div>

      <div class="runtime-grid">
        <div class="runtime-box">
          <div class="runtime-title">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(siDocker.path)} /></svg>
            <strong>Docker-compatible runtime</strong>
          </div>
          <p>Docker Engine or rootful Podman through the same command/socket contract.</p>
        </div>
        <div class="runtime-box statd">
          <span class="node-kicker">HOST NATIVE</span>
          <strong>mypaas-statd</strong>
          <p>systemd + Unix socket · cgroup v2 telemetry</p>
        </div>
        <div class="runtime-box project">
          <span class="node-kicker">PROJECT OUTPUT</span>
          <strong>Containers</strong>
          <p>Dockerfile · Compose · public OCI image</p>
        </div>
        <div class="runtime-box project">
          <span class="node-kicker">PROJECT OUTPUT</span>
          <strong>Static release</strong>
          <p>Atomic files served directly by Caddy</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.blueprint{width:min(calc(100% - 2rem),var(--page-width));margin:0 auto;padding:2.5rem 0 2rem;border-top:1px solid var(--app-border-strong)}
.blueprint-head{display:grid;grid-template-columns:1fr minmax(18rem,.7fr);gap:3rem;align-items:end;margin-bottom:1.4rem}.eyebrow,.node-kicker,.host-title span{font-family:var(--font-mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--app-subtle)}h2{max-width:14ch;margin:.6rem 0 0;font-size:clamp(1.85rem,3.5vw,3rem);line-height:1.02;letter-spacing:-.035em}.blueprint-head p{margin:0;color:var(--app-muted);font-size:.82rem;line-height:1.55}
.diagram{position:relative;padding:1rem;border:1px solid var(--app-border-strong);background-image:linear-gradient(var(--app-border) 1px,transparent 1px),linear-gradient(90deg,var(--app-border) 1px,transparent 1px);background-size:24px 24px;background-color:var(--app-bg)}
.lane{display:grid;align-items:stretch}.ingress{grid-template-columns:minmax(0,1fr) 5rem minmax(0,1fr);max-width:34rem;margin:0 auto 1rem}.control{grid-template-columns:repeat(3,1fr);gap:1px;background:var(--app-border-strong);border:1px solid var(--app-border-strong)}
.node{background:var(--app-surface)}.icon-node{display:flex;align-items:center;justify-content:center;gap:.65rem;min-height:3.25rem;border:1px solid var(--app-border-strong);font-size:.74rem;font-weight:620}.icon-node svg,.panel svg,.host-title svg,.runtime-title svg{width:1.1rem;height:1.1rem;fill:currentColor;flex:0 0 auto}.wire{position:relative}.wire:before{content:"";position:absolute;left:.6rem;right:.6rem;top:50%;height:1px;background:var(--app-border-strong)}.wire i{position:absolute;left:50%;top:calc(50% - 3px);width:6px;height:6px;background:var(--app-ink)}
.bus{display:grid;grid-template-columns:repeat(3,1fr);height:1.2rem;margin:0 12%;position:relative}.bus:before{content:"";position:absolute;left:16.5%;right:16.5%;top:.55rem;height:1px;background:var(--app-border-strong)}.bus i{justify-self:center;width:1px;height:100%;background:var(--app-border-strong)}
.panel{display:grid;align-content:start;gap:.3rem;min-height:7rem;padding:.85rem}.panel.primary{background:var(--app-ink);color:var(--app-bg)}.panel strong{font-size:.86rem}.panel small{color:var(--app-subtle);font-size:.67rem;line-height:1.4}.panel.primary small,.panel.primary .node-kicker{color:color-mix(in srgb,var(--app-bg) 65%,transparent)}
.host-shell{margin-top:1rem;border:1px solid var(--app-border-strong);background:var(--app-surface)}.host-title{display:flex;align-items:center;gap:.65rem;padding:.7rem .85rem;border-bottom:1px solid var(--app-border-strong)}.host-title>div{display:grid;gap:.05rem}.host-title strong{font-size:.74rem;font-weight:600}.runtime-grid{display:grid;grid-template-columns:1.3fr .7fr 1fr 1fr;gap:1px;background:var(--app-border)}.runtime-box{min-height:7rem;padding:.8rem;background:var(--app-surface)}.runtime-title{display:flex;align-items:center;gap:.5rem}.runtime-box strong{display:block;margin:.25rem 0;font-size:.78rem}.runtime-box p{margin:.35rem 0 0;color:var(--app-muted);font-size:.66rem;line-height:1.45}
@media(max-width:820px){.blueprint-head{grid-template-columns:1fr;gap:1rem}.control,.runtime-grid{grid-template-columns:1fr 1fr}.ingress{max-width:none}.bus{display:none}.control{margin-top:.75rem}.panel{min-height:6rem}.runtime-grid>.runtime-box:first-child{grid-column:1/-1}}
@media(max-width:520px){.blueprint{width:min(calc(100% - 1.25rem),var(--page-width));padding-top:2rem}.diagram{padding:.65rem}.ingress{grid-template-columns:1fr}.wire{height:1.4rem}.wire:before{left:50%;top:.15rem;bottom:.15rem;width:1px;height:auto}.wire i{top:calc(50% - 3px);left:calc(50% - 3px)}.control,.runtime-grid{grid-template-columns:1fr}.runtime-grid>.runtime-box:first-child{grid-column:auto}}
</style>
