---
import { repositoryUrl, type Locale } from "../../lib/site";
import AgentRobotIcon from "./AgentRobotIcon.astro";
import InterfaceIcon from "./InterfaceIcon.astro";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;

const content = {
  en: {
    whyHeading: "WHY MYPAAS",
    whyItems: [
      { title: "Self-hosted ownership", body: ["Your host, workloads,", "persistent data, and routing", "stay under your control."], icon: "server" },
      { title: "Single-host focused", body: ["Not trying to be Kubernetes.", "One host, less distributed", "systems overhead."], icon: "cube" },
      { title: "Recovery is first-class", body: ["Rollback, restore, retention,", "and update verification are", "part of the operating model."], icon: "puzzle" },
      { title: "Operational visibility", body: ["Build and runtime logs plus", "metrics in the project view.", "statd telemetry is optional."], icon: "bars" },
      { title: "One control surface", body: ["Deploy, route, inspect, and", "recover without stitching", "separate control apps."], icon: "robot" },
      { title: "Podman-first runtime", body: ["Rootful Podman by default.", "Docker Engine compatibility.", "One Docker-compatible contract."], icon: "terminal" },
    ],
    footerBody: "Self-hosted deployment control plane for one Linux server.",
    product: "PRODUCT", resources: "RESOURCES", project: "PROJECT",
    features: "Features", architecture: "Architecture", integrations: "Integrations", docs: "Docs", security: "Security", privacy: "Privacy", changelog: "Changelog", github: "GitHub", discussions: "Discussions", automation: "Automation & MCP",
    githubCard: "Open source. Evidence before claims.", githubAction: "View on GitHub",
  },
  id: {
    whyHeading: "KENAPA MYPAAS",
    whyItems: [
      { title: "Kepemilikan self-hosted", body: ["Host, workload, data persisten,", "dan jalur routing tetap", "di bawah kendali Anda."], icon: "server" },
      { title: "Fokus single-host", body: ["Tidak mencoba menjadi Kubernetes.", "Satu host, lebih sedikit", "overhead distributed system."], icon: "cube" },
      { title: "Recovery first-class", body: ["Rollback, restore, retention,", "dan verifikasi update menjadi", "bagian operating model."], icon: "puzzle" },
      { title: "Visibilitas operasional", body: ["Build log, runtime log, dan", "metrics tersedia di project.", "Telemetry statd bersifat opsional."], icon: "bars" },
      { title: "Satu control surface", body: ["Deploy, route, inspect, dan", "recover tanpa merangkai", "control app terpisah."], icon: "robot" },
      { title: "Runtime Podman-first", body: ["Rootful Podman sebagai default.", "Docker Engine mode kompatibilitas.", "Satu contract kompatibel Docker."], icon: "terminal" },
    ],
    footerBody: "Deployment control plane self-hosted untuk satu server Linux.",
    product: "PRODUK", resources: "RESOURCE", project: "PROJECT",
    features: "Fitur", architecture: "Arsitektur", integrations: "Integrasi", docs: "Dokumentasi", security: "Keamanan", privacy: "Privasi", changelog: "Changelog", github: "GitHub", discussions: "Diskusi", automation: "Automation & MCP",
    githubCard: "Open source. Evidence sebelum klaim.", githubAction: "Lihat di GitHub",
  },
  zh: {
    whyHeading: "为什么选择 MYPAAS",
    whyItems: [
      { title: "自托管所有权", body: ["主机、工作负载、持久数据", "与路由路径都保留在", "你的控制之下。"], icon: "server" },
      { title: "专注单机", body: ["并不试图成为 Kubernetes。", "一台主机，更少的", "分布式系统开销。"], icon: "cube" },
      { title: "恢复是一等能力", body: ["回滚、恢复、保留策略", "与更新验证都属于", "日常运维模型。"], icon: "puzzle" },
      { title: "运维可见性", body: ["项目视图提供构建与运行日志", "以及运行指标。", "statd 遥测为可选能力。"], icon: "bars" },
      { title: "一个控制界面", body: ["部署、路由、检查与恢复", "无需拼接多个独立的", "控制应用。"], icon: "robot" },
      { title: "Podman-first 运行时", body: ["默认 Rootful Podman。", "Docker Engine 兼容模式。", "共用 Docker-compatible 契约。"], icon: "terminal" },
    ],
    footerBody: "面向单台 Linux 服务器的自托管部署控制平面。",
    product: "产品", resources: "资源", project: "项目",
    features: "功能", architecture: "架构", integrations: "集成", docs: "文档", security: "安全", privacy: "隐私", changelog: "更新日志", github: "GitHub", discussions: "讨论", automation: "自动化与 MCP",
    githubCard: "开源。先有证据，再做声明。", githubAction: "在 GitHub 查看",
  },
} as const;

const copy = content[locale];
---

<section class="why-section reference-panel" id="features" aria-labelledby="why-heading">
  <header class="panel-heading">
    <InterfaceIcon name="star" size={21} strokeWidth={1.55} />
    <h2 id="why-heading">{copy.whyHeading}</h2>
  </header>

  <div class="why-grid">
    {copy.whyItems.map((item) => (
      <article class="why-card">
        <div class="why-title-row">
          {item.icon === "server" && <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="4" y="5" width="24" height="6" rx="2"/><rect x="4" y="13" width="24" height="6" rx="2"/><rect x="4" y="21" width="24" height="6" rx="2"/><circle cx="9" cy="8" r="1"/><circle cx="9" cy="16" r="1"/><circle cx="9" cy="24" r="1"/></svg>}
          {item.icon === "puzzle" && <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M12 4h6v5a4 4 0 1 1 5 5h5v6h-5a4 4 0 1 1-5 5v3h-6v-5a4 4 0 1 1-5-5H4v-6h5a4 4 0 1 1 3-3V4Z"/></svg>}
          {item.icon === "cube" && <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 11 6v14l-11 6-11-6V9l11-6Zm0 0v13m11-7-11 7L5 9m11 7v13"/></svg>}
          {item.icon === "bars" && <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 27h24M6 27V17h5v10m4 0V8h5v19m4 0V13h5v14"/></svg>}
          {item.icon === "robot" && <AgentRobotIcon size={28} strokeWidth={1.7} />}
          {item.icon === "terminal" && <InterfaceIcon name="terminal" size={28} strokeWidth={1.6} />}
          <h3>{item.title}</h3>
        </div>
        <p>{item.body.map((line) => <>{line}<br /></>)}</p>
      </article>
    ))}
  </div>
</section>

<footer class="reference-footer">
  <div class="footer-inner">
    <div class="footer-brand"><img src="/brand/logowithtext_white.png" alt="MyPaaS" /><p>{copy.footerBody}</p></div>
    <nav class="footer-column" aria-label="Product links"><strong>{copy.product}</strong><a href="#features">{copy.features}</a><a href="#architecture">{copy.architecture}</a><a href="#integrations">{copy.integrations}</a></nav>
    <nav class="footer-column" aria-label="Resource links"><strong>{copy.resources}</strong><a href="/docs/">{copy.docs}</a><a href="/docs/security/">{copy.security}</a><a href="/privacy/">{copy.privacy}</a></nav>
    <nav class="footer-column" aria-label="Project links"><strong>{copy.project}</strong><a href={repositoryUrl} target="_blank" rel="noreferrer">{copy.github}</a><a href={`${repositoryUrl}/releases`} target="_blank" rel="noreferrer">{copy.changelog}</a><a href={`${repositoryUrl}/discussions`} target="_blank" rel="noreferrer">{copy.discussions}</a><a href="/docs/automation/">{copy.automation}</a></nav>
    <div class="github-card"><p>{copy.githubCard}</p><a href={repositoryUrl} target="_blank" rel="noreferrer"><InterfaceIcon name="star" size={20} strokeWidth={1.55} /><span>{copy.githubAction}</span></a></div>
  </div>
</footer>

<style>
:global(body){background:#fff}.reference-panel{width:min(calc(100% - 36px),1368px);margin:0 auto var(--landing-panel-gap);padding:var(--landing-panel-padding);border:1px solid #dedede;border-radius:var(--landing-panel-radius);background:#fff;color:#111;box-shadow:none}.panel-heading{display:flex;align-items:center;gap:11px;margin-bottom:20px}.panel-heading h2{margin:0;font-family:var(--font-heading);font-size:var(--landing-section-label-size);font-weight:400;line-height:1;letter-spacing:.08em}.panel-heading>svg{width:21px;height:21px;fill:none;stroke:#101010;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.why-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:var(--landing-card-gap)}.why-card{display:grid;grid-template-rows:44px 1fr;gap:14px;min-width:0;min-height:176px;padding:var(--landing-card-padding);border:1px solid #dedede;border-radius:var(--landing-card-radius);background:#fff}.why-title-row{display:flex;min-height:44px;align-items:flex-start;gap:12px;color:#111}.why-title-row>svg{width:27px;height:27px;flex:none;margin-top:1px;fill:none;stroke:#111;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.why-title-row h3{margin:0;font-family:var(--font-sans);font-size:var(--landing-card-title-size);font-weight:700;line-height:1.25}.why-card p{margin:0;color:#555;font-family:var(--font-sans);font-size:var(--landing-card-body-size);line-height:1.42}.reference-footer{width:100%;margin-top:0;background:#07080b;color:#fff}.footer-inner{display:grid;grid-template-columns:2fr .8fr .9fr 1fr 1.65fr;gap:48px;width:min(calc(100% - 72px),1320px);margin:0 auto;padding:27px 0 26px;align-items:start}.footer-brand img{width:136px;height:auto}.footer-brand p{margin:10px 0 0;color:#b8bac1;font-family:var(--font-sans);font-size:12.5px;line-height:1.45}.footer-column{display:grid;align-content:start;gap:5px}.footer-column strong{margin-bottom:4px;color:#fff;font-family:var(--font-sans);font-size:11px;font-weight:700}.footer-column a{color:#bcbec4;font-family:var(--font-sans);font-size:12px;line-height:1.25;text-decoration:none}.footer-column a:hover,.footer-column a:focus-visible{color:#fff}.github-card{padding:15px 18px 13px;border:1px solid #3a3d45;background:#0c0d11}.github-card>p{margin:0 0 12px;color:#d7d8dc;font-family:var(--font-sans);font-size:12px}.github-card>a{display:flex;align-items:center;gap:10px;color:#fff;font-family:var(--font-sans);font-size:12px;font-weight:650;text-decoration:none}
@media(max-width:1100px){.why-grid{grid-template-columns:repeat(3,1fr)}.footer-inner{grid-template-columns:1.6fr repeat(3,1fr);gap:28px}.github-card{grid-column:1/-1;max-width:360px}}
@media(max-width:680px){.reference-panel{width:calc(100% - 20px);padding:20px 15px}.why-grid{grid-template-columns:1fr}.why-card{min-height:0}.footer-inner{grid-template-columns:1fr 1fr;width:calc(100% - 32px);gap:24px;padding-block:24px}.footer-brand,.github-card{grid-column:1/-1}.github-card{max-width:none}}
</style>
