---
import { Image } from "astro:assets";
import { repositoryUrl, type Locale } from "../../lib/site";
import InterfaceIcon from "./InterfaceIcon.astro";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;

const content = {
  en: {
    footerBody: "Self-hosted deployment control plane for one Linux server.",
    product: "PRODUCT", resources: "RESOURCES", project: "PROJECT",
    architecture: "Architecture", capabilities: "Capabilities", scope: "Beta scope",
    docs: "Docs", changelog: "Changelog", privacy: "Privacy",
    github: "GitHub", discussions: "Discussions", automation: "Automation & MCP", security: "Security",
    githubCard: "Open source. Evidence before claims.", star: "View on GitHub",
  },
  id: {
    footerBody: "Deployment control plane self-hosted untuk satu server Linux.",
    product: "PRODUK", resources: "RESOURCE", project: "PROJECT",
    architecture: "Arsitektur", capabilities: "Kapabilitas", scope: "Scope beta",
    docs: "Dokumentasi", changelog: "Changelog", privacy: "Privasi",
    github: "GitHub", discussions: "Diskusi", automation: "Automation & MCP", security: "Keamanan",
    githubCard: "Open source. Evidence sebelum klaim.", star: "Lihat di GitHub",
  },
  zh: {
    footerBody: "面向单台 Linux 服务器的自托管部署控制平面。",
    product: "产品", resources: "资源", project: "项目",
    architecture: "架构", capabilities: "能力", scope: "Beta 范围",
    docs: "文档", changelog: "更新日志", privacy: "隐私",
    github: "GitHub", discussions: "讨论", automation: "自动化与 MCP", security: "安全",
    githubCard: "开源。先有证据，再做声明。", star: "在 GitHub 查看",
  },
} as const;

const copy = content[locale];
---

<footer class="reference-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Image src="/brand/logowithtext_white.png" alt="MyPaaS" width={136} height={42} />
      <p>{copy.footerBody}</p>
    </div>

    <nav class="footer-column" aria-label="Product links">
      <strong>{copy.product}</strong>
      <a href="#architecture">{copy.architecture}</a>
      <a href="#capabilities">{copy.capabilities}</a>
      <a href="#scope">{copy.scope}</a>
    </nav>

    <nav class="footer-column" aria-label="Resource links">
      <strong>{copy.resources}</strong>
      <a href="/docs/">{copy.docs}</a>
      <a href={`${repositoryUrl}/releases`} target="_blank" rel="noreferrer">{copy.changelog}</a>
      <a href="/privacy/">{copy.privacy}</a>
      <a href="/docs/security/">{copy.security}</a>
    </nav>

    <nav class="footer-column" aria-label="Project links">
      <strong>{copy.project}</strong>
      <a href={repositoryUrl} target="_blank" rel="noreferrer">{copy.github}</a>
      <a href={`${repositoryUrl}/discussions`} target="_blank" rel="noreferrer">{copy.discussions}</a>
      <a href="/docs/automation/">{copy.automation}</a>
    </nav>

    <div class="github-card">
      <p>{copy.githubCard}</p>
      <a href={repositoryUrl} target="_blank" rel="noreferrer" aria-label={copy.githubCard}>
        <InterfaceIcon name="star" size={20} strokeWidth={1.55} />
        <span aria-hidden="true">{copy.star}</span>
      </a>
    </div>
  </div>
</footer>

<style>
:global(body){background:#fff}
.reference-footer{width:100%;margin-top:0;background:#07080b;color:#fff}
.footer-inner{display:grid;grid-template-columns:2fr .82fr .92fr 1fr 1.65fr;gap:48px;width:min(calc(100% - 72px),1320px);margin:0 auto;padding:30px 0 28px;align-items:start}
.footer-brand img{width:136px;height:auto}.footer-brand p{max-width:260px;margin:10px 0 0;color:#b8bac1;font-family:var(--font-sans);font-size:12.5px;line-height:1.45}
.footer-column{display:grid;align-content:start;gap:5px}.footer-column strong{margin-bottom:4px;color:#fff;font-family:var(--font-sans);font-size:11px;font-weight:700}.footer-column a{color:#bcbec4;font-family:var(--font-sans);font-size:12px;line-height:1.3;text-decoration:none}.footer-column a:hover{color:#fff}
.github-card{padding:15px 18px 13px;border:1px solid #3a3d45;background:#0c0d11}.github-card>p{margin:0 0 12px;color:#d7d8dc;font-family:var(--font-sans);font-size:12px}.github-card>a{display:flex;align-items:center;gap:10px;color:#fff;font-family:var(--font-sans);font-size:12px;font-weight:650;text-decoration:none}
@media(max-width:1100px){.footer-inner{grid-template-columns:1.6fr repeat(3,1fr);gap:28px}.github-card{grid-column:1/-1;max-width:360px}}
@media(max-width:680px){.footer-inner{grid-template-columns:1fr 1fr;width:calc(100% - 32px);gap:24px;padding-block:24px}.footer-brand,.github-card{grid-column:1/-1}.github-card{max-width:none}}
</style>
