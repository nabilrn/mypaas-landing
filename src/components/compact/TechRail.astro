---
import { siCaddy, siCloudflare, siDocker, siGithub, siLinux, siPodman, siPostgresql, siUbuntu } from "simple-icons";
const items = [
  ["GitHub", siGithub],
  ["Cloudflare", siCloudflare],
  ["Podman", siPodman],
  ["Docker", siDocker],
  ["Caddy", siCaddy],
  ["PostgreSQL", siPostgresql],
  ["Linux", siLinux],
  ["Ubuntu", siUbuntu],
] as const;
---
<div class="integration-strip" aria-label="MyPaaS integrations and runtime ecosystem">
  <p>Works with GitHub, Cloudflare, standard Linux tooling, and MCP-compatible agent workflows.</p>
  <div class="logo-row">
    {items.map(([name, icon]) => (
      <div class="logo-tile" style={`--brand:#${icon.hex}`} title={name} aria-label={name}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path} /></svg>
        <span>{name}</span>
      </div>
    ))}
    <div class="logo-tile mcp" title="Model Context Protocol" aria-label="Model Context Protocol">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.25"/><circle cx="18" cy="6" r="2.25"/><circle cx="18" cy="18" r="2.25"/><path d="M8 11.2 15.7 7M8 12.8l7.7 4.2"/></svg>
      <span>MCP</span>
    </div>
  </div>
</div>

<style>
.integration-strip{display:grid;grid-template-columns:minmax(13rem,.7fr) minmax(0,2.3fr);gap:1.2rem;align-items:center;padding:1rem;border:1px solid var(--app-border-strong);background:var(--app-surface)}.integration-strip>p{max-width:18rem;margin:0;color:var(--app-muted);font-size:.92rem;line-height:1.48}.logo-row{display:grid;grid-template-columns:repeat(9,minmax(4.4rem,1fr));gap:.45rem}.logo-tile{display:grid;min-width:0;min-height:4.5rem;align-content:center;justify-items:center;gap:.42rem;padding:.62rem .35rem;border:1px solid var(--app-border);background:var(--app-bg)}.logo-tile svg{width:1.45rem;height:1.45rem;fill:var(--brand)}.logo-tile span{max-width:100%;overflow:hidden;color:var(--app-ink);font-size:.69rem;font-weight:650;text-overflow:ellipsis;white-space:nowrap}.logo-tile.mcp svg{fill:none;stroke:var(--app-ink);stroke-width:1.7;stroke-linecap:square;stroke-linejoin:miter}
@media(max-width:960px){.integration-strip{grid-template-columns:1fr}.integration-strip>p{max-width:38rem}.logo-row{grid-template-columns:repeat(5,1fr)}}
@media(max-width:600px){.integration-strip{padding:.75rem}.logo-row{display:flex;overflow-x:auto;padding-bottom:.25rem}.logo-tile{flex:0 0 5.2rem}.integration-strip>p{font-size:.86rem}}
</style>
