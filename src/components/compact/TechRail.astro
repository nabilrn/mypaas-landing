---
import { siCaddy, siCloudflare, siDocker, siGithub, siLinux, siPodman, siPostgresql } from "simple-icons";
import AgentRobotIcon from "./AgentRobotIcon.astro";
import DistroStack from "./DistroStack.astro";
const items = [
  ["GitHub", siGithub],
  ["Cloudflare", siCloudflare],
  ["Docker", siDocker],
  ["Podman", siPodman],
  ["Caddy", siCaddy],
  ["PostgreSQL", siPostgresql],
  ["Linux", siLinux],
] as const;
---
<div class="integration-strip" aria-label="MyPaaS integrations and runtime ecosystem">
  <p>Built for the stack you already run.</p>
  <div class="logo-row">
    {items.map(([name, icon]) => (
      <div class="logo-tile" title={name} aria-label={name}>
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path} /></svg>
        <span>{name}</span>
      </div>
    ))}
    <div class="logo-tile distro-tile" title="Ubuntu and Debian" aria-label="Ubuntu and Debian">
      <DistroStack compact />
      <span>Ubuntu / Debian</span>
    </div>
    <div class="logo-tile mcp" title="Model Context Protocol" aria-label="Model Context Protocol">
      <AgentRobotIcon size={24} strokeWidth={1.5} />
      <span>MCP</span>
    </div>
  </div>
</div>

<style>
.integration-strip{
  position:relative;
  z-index:12;
  display:grid;
  grid-template-columns:minmax(15rem,.72fr) minmax(0,2.65fr);
  gap:1rem;
  width:min(calc(100vw - 56px),86.5rem);
  margin:0 0 0 50%;
  padding:.82rem 1rem;
  transform:translateX(-50%);
  align-items:center;
  border:1px solid #d6d6d6;
  border-radius:16px;
  background:#fff;
  box-shadow:none;
}
.integration-strip>p{max-width:16.5rem;margin:0;color:#262626;font-family:var(--font-sans);font-size:.86rem;line-height:1.42}
.logo-row{display:grid;grid-template-columns:repeat(9,minmax(4.35rem,1fr));gap:.46rem}
.logo-tile{
  display:grid;
  min-width:0;
  min-height:4.45rem;
  align-content:center;
  justify-items:center;
  gap:.34rem;
  padding:.52rem .3rem;
  border:1px solid #dedede;
  border-radius:10px;
  background:#fff;
  color:#1b1b1b;
  box-shadow:none;
}
.logo-tile .brand-mark{width:24px;height:24px;fill:currentColor}
.logo-tile span{max-width:100%;overflow:hidden;color:#111;font-family:var(--font-sans);font-size:.68rem;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
.logo-tile.mcp{color:#1b1b1b}.distro-tile span{font-size:.61rem}

@media(max-width:1100px){
  .integration-strip{grid-template-columns:1fr;width:min(calc(100vw - 36px),62rem);margin-left:50%;padding:.8rem}
  .integration-strip>p{max-width:38rem}
  .logo-row{grid-template-columns:repeat(5,1fr)}
}
@media(max-width:650px){
  .integration-strip{width:calc(100vw - 24px);margin-left:50%;padding:.72rem;border-radius:14px}
  .logo-row{display:flex;overflow-x:auto;padding-bottom:.2rem;scrollbar-width:thin}
  .logo-tile{flex:0 0 5.1rem;min-height:4.3rem}
  .integration-strip>p{font-size:.82rem}
}
</style>
