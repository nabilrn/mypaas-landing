---
import { siCaddy, siCloudflare, siDocker, siGithub, siLinux, siPodman, siPostgresql, siUbuntu } from "simple-icons";
const items = [
  ["GitHub", siGithub],
  ["Cloudflare", siCloudflare],
  ["Docker", siDocker],
  ["Podman", siPodman],
  ["Caddy", siCaddy],
  ["PostgreSQL", siPostgresql],
  ["Linux", siLinux],
  ["Ubuntu", siUbuntu],
] as const;
---
<div class="integration-strip" aria-label="MyPaaS integrations and runtime ecosystem">
  <p>Works with GitHub, Cloudflare, and MCP-compatible agent workflows.</p>
  <div class="logo-row">
    {items.map(([name, icon]) => (
      <div class="logo-tile" style={`--brand:#${icon.hex}`} title={name} aria-label={name}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path} /></svg>
        <span>{name}</span>
      </div>
    ))}
    <div class="logo-tile mcp" title="Model Context Protocol" aria-label="Model Context Protocol">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1" />
        <path d="M8.8 2.9 12 12l3.2 9.1M21.1 8.8 12 12 2.9 15.2" />
      </svg>
      <span>MCP</span>
    </div>
  </div>
</div>

<style>
.integration-strip{
  position:relative;
  z-index:12;
  display:grid;
  grid-template-columns:minmax(16rem,.78fr) minmax(0,2.55fr);
  gap:1.2rem;
  width:min(calc(100vw - 56px),86.5rem);
  margin:-44px 0 0 50%;
  padding:1.05rem 1.25rem;
  transform:translateX(-50%);
  align-items:center;
  border:1px solid #d9d9d9;
  border-radius:18px;
  background:#fff;
  box-shadow:0 16px 36px rgb(0 0 0 / .11);
}
.integration-strip>p{max-width:17.5rem;margin:0;color:#262626;font-size:.92rem;line-height:1.48}
.logo-row{display:grid;grid-template-columns:repeat(9,minmax(4.6rem,1fr));gap:.55rem}
.logo-tile{
  display:grid;
  min-width:0;
  min-height:5.15rem;
  align-content:center;
  justify-items:center;
  gap:.48rem;
  padding:.7rem .35rem;
  border:1px solid #dedede;
  border-radius:11px;
  background:#fff;
  box-shadow:inset 0 1px 0 rgb(255 255 255 / .8);
}
.logo-tile svg{width:1.9rem;height:1.9rem;fill:var(--brand)}
.logo-tile span{max-width:100%;overflow:hidden;color:#111;font-size:.72rem;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
.logo-tile.mcp svg{fill:none;stroke:#181818;stroke-width:1.45;stroke-linecap:square;stroke-linejoin:miter}

@media(max-width:1100px){
  .integration-strip{grid-template-columns:1fr;width:min(calc(100vw - 36px),62rem);margin-top:-34px}
  .integration-strip>p{max-width:38rem}
  .logo-row{grid-template-columns:repeat(5,1fr)}
}
@media(max-width:650px){
  .integration-strip{width:calc(100vw - 24px);margin-top:-24px;padding:.8rem;border-radius:14px}
  .logo-row{display:flex;overflow-x:auto;padding-bottom:.2rem;scrollbar-width:thin}
  .logo-tile{flex:0 0 5.4rem;min-height:4.7rem}
  .integration-strip>p{font-size:.84rem}
}
</style>
