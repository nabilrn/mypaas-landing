---
import type { Locale } from "../../lib/site";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;

const content = {
  en: {
    label: "CURRENT CAPABILITIES",
    title: "A focused control plane for one Linux host.",
    body: "MyPaaS handles deployment and day-to-day operations while the applications remain ordinary workloads on your server.",
    groups: [
      ["Deploy", "Git Dockerfile, Docker Compose, static sites, and public OCI images."],
      ["Route", "Automatic project routing through Caddy after the intended runtime is ready."],
      ["Operate", "Deployment history, logs, metrics, restart, redeploy, rollback, and resource settings."],
      ["Data", "PostgreSQL provisioning, DB Studio Lite, backups, restore, and migration tooling."],
      ["Automate", "CLI, REST API, GitHub webhooks, and an optional local MCP bridge."],
      ["Observe", "Project telemetry plus optional mypaas-statd host/runtime metrics."],
    ],
    boundaryLabel: "CURRENT BOUNDARY",
    boundaryTitle: "The server is still the limit.",
    boundaryBody: "MyPaaS does not turn a small VM into unlimited infrastructure. Build cost and runtime capacity depend on the application and the CPU, memory, storage, network, and databases available on the host.",
    boundaries: ["Single Linux host", "Owner or small trusted team", "No multi-node HA scheduler", "No universal RPS, user-count, or project-count claim"],
  },
  id: {
    label: "KAPABILITAS SAAT INI",
    title: "Control plane yang fokus untuk satu host Linux.",
    body: "MyPaaS menangani deployment dan operasi harian, sementara aplikasi tetap menjadi workload biasa yang memakai resource server Anda.",
    groups: [
      ["Deploy", "Git Dockerfile, Docker Compose, static site, dan public OCI image."],
      ["Routing", "Routing project otomatis melalui Caddy setelah runtime yang dituju siap."],
      ["Operasi", "Riwayat deployment, log, metrik, restart, redeploy, rollback, dan pengaturan resource."],
      ["Data", "Provisioning PostgreSQL, DB Studio Lite, backup, restore, dan tooling migrasi."],
      ["Automasi", "CLI, REST API, GitHub webhook, dan local MCP bridge opsional."],
      ["Observability", "Telemetry project serta metrik host/runtime opsional melalui mypaas-statd."],
    ],
    boundaryLabel: "BATAS SAAT INI",
    boundaryTitle: "Batasnya tetap resource server.",
    boundaryBody: "MyPaaS tidak mengubah VM kecil menjadi infrastruktur tanpa batas. Biaya build dan kapasitas runtime bergantung pada aplikasi serta CPU, memory, storage, network, dan database yang tersedia pada host.",
    boundaries: ["Satu host Linux", "Owner atau tim kecil tepercaya", "Tanpa scheduler HA multi-node", "Tanpa klaim universal RPS, jumlah user, atau jumlah project"],
  },
  zh: {
    label: "当前能力",
    title: "面向单台 Linux 主机的专注控制平面。",
    body: "MyPaaS 负责部署与日常运维，应用本身仍然是运行在您服务器资源上的普通工作负载。",
    groups: [
      ["部署", "Git Dockerfile、Docker Compose、静态站点和公开 OCI 镜像。"],
      ["路由", "目标运行时就绪后，通过 Caddy 自动建立项目路由。"],
      ["运维", "部署历史、日志、指标、重启、重新部署、回滚和资源配置。"],
      ["数据", "PostgreSQL 配置、DB Studio Lite、备份、恢复和迁移工具。"],
      ["自动化", "CLI、REST API、GitHub Webhook 和可选的本地 MCP bridge。"],
      ["可观测性", "项目遥测，以及可选的 mypaas-statd 主机/运行时指标。"],
    ],
    boundaryLabel: "当前边界",
    boundaryTitle: "服务器资源仍然决定上限。",
    boundaryBody: "MyPaaS 不会把小型 VM 变成无限基础设施。构建成本和运行容量取决于应用本身以及主机可用的 CPU、内存、存储、网络和数据库资源。",
    boundaries: ["单台 Linux 主机", "所有者或小型可信团队", "无多节点 HA 调度器", "不承诺通用 RPS、用户数或项目数"],
  },
}[locale];
---

<section class="capability-section" id="capabilities" aria-labelledby="capability-title">
  <div class="section-head">
    <span>{content.label}</span>
    <div>
      <h2 id="capability-title">{content.title}</h2>
      <p>{content.body}</p>
    </div>
  </div>
  <div class="capability-grid">
    {content.groups.map(([title, body], index) => (
      <article>
        <small>{String(index + 1).padStart(2, "0")}</small>
        <h3>{title}</h3>
        <p>{body}</p>
      </article>
    ))}
  </div>
</section>

<section class="boundary-section" id="limitations" aria-labelledby="boundary-title">
  <div class="section-head">
    <span>{content.boundaryLabel}</span>
    <div>
      <h2 id="boundary-title">{content.boundaryTitle}</h2>
      <p>{content.boundaryBody}</p>
    </div>
  </div>
  <ul>
    {content.boundaries.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
.capability-section,.boundary-section{width:min(calc(100% - 36px),1368px);margin:0 auto var(--landing-panel-gap);padding:var(--landing-panel-padding);border:1px solid #d8d8d8;background:#fff;color:#111}.section-head{display:grid;grid-template-columns:minmax(170px,.55fr) minmax(0,1.45fr);gap:24px;margin-bottom:28px}.section-head>span{padding-top:6px;font-family:var(--font-mono);font-size:var(--landing-section-label-size);font-weight:600;letter-spacing:.08em}.section-head h2{max-width:18ch;margin:0;font-family:var(--font-heading);font-size:clamp(2rem,3.2vw,3.25rem);font-weight:400;line-height:1.02;letter-spacing:-.03em}.section-head p{max-width:54rem;margin:12px 0 0;color:#555;font-size:14px;line-height:1.6}.capability-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #ddd;border-left:1px solid #ddd}.capability-grid article{min-height:180px;padding:22px;border-right:1px solid #ddd;border-bottom:1px solid #ddd}.capability-grid small{font-family:var(--font-mono);color:#777}.capability-grid h3{margin:28px 0 8px;font-size:1.05rem}.capability-grid p{margin:0;color:#555;font-size:14px;line-height:1.55}.boundary-section ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;border-top:1px solid #ddd;border-left:1px solid #ddd;list-style:none}.boundary-section li{padding:18px;border-right:1px solid #ddd;border-bottom:1px solid #ddd;font-size:14px;line-height:1.45}@media(max-width:820px){.section-head{grid-template-columns:1fr}.capability-grid{grid-template-columns:1fr 1fr}.boundary-section ul{grid-template-columns:1fr 1fr}}@media(max-width:560px){.capability-grid,.boundary-section ul{grid-template-columns:1fr}}
</style>
