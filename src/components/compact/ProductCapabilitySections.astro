const copy = content[locale];
const cliMax = 60;
---

<section class="evidence-section technical-frame" id="beta-evidence" aria-labelledby="beta-evidence-title">
  <div class="section-intro">
    <span class="section-label">{copy.evidenceLabel}</span>
    <h2 id="beta-evidence-title">{copy.evidenceTitle}</h2>
    <p>{copy.evidenceBody}</p>
  </div>

  <div class="gate-board" aria-label={copy.gateSummary}>
    <div class="gate-board-head"><strong>{copy.gateSummary}</strong><span>v0.5.0-beta.1</span></div>
    <div class="gate-grid">
      {copy.gates.map((gate, index) => (
        <div class="gate-row"><span class="gate-index">{String(index + 1).padStart(2,"0")}</span><strong>{gate}</strong><span class="pass">{copy.gateStatus}</span></div>
      ))}
    </div>
  </div>

  <div class="benchmark-grid">
    <article class="benchmark-card capacity-card technical-frame">
      <header><span>PHASE 3</span><h3>{copy.capacityTitle}</h3><p>{copy.capacityBody}</p></header>
      <div class="capacity-chart" role="img" aria-label="Qualification tiers: 10 projects, 25 projects, and 50 projects with 50 out of 50 successful at the largest tier">
        {copy.capacityTiers.map(([tier,label,width]) => (
          <div class="capacity-row"><div><span>{tier}</span><strong>{label}</strong></div><div class="track"><i style={`width:${width}%`}></i></div></div>
        ))}
      </div>
      <p class="benchmark-note">{copy.capacityNote}</p>
    </article>

    <article class="benchmark-card statd-card technical-frame">
      <header><span>RUNTIME METRICS</span><h3>{copy.statdTitle}</h3><p>{copy.statdBody}</p></header>
      <div class="legend"><span><i class="legend-cli"></i>{copy.statdLegendCli}</span><span><i class="legend-statd"></i>{copy.statdLegendNative}</span></div>
      <div class="latency-chart" role="img" aria-label="Three historical benchmark trials comparing Docker-compatible CLI and mypaas-statd p50 runtime metrics latency">
        {copy.statdTrials.map(([trial,cli,statd]) => (
          <div class="trial">
            <strong>{trial}</strong>
            <div class="metric-line"><span>CLI</span><div class="track"><i class="cli-bar" style={`width:${Number(cli) / cliMax * 100}%`}></i></div><b>{Number(cli).toFixed(2)} ms</b></div>
            <div class="metric-line"><span>statd</span><div class="track"><i class="statd-bar" style={`width:${Number(statd) / cliMax * 100}%`}></i></div><b>{Number(statd).toFixed(2)} ms</b></div>
          </div>
        ))}
      </div>
      <div class="spawn-proof"><span>{copy.statdSpawn}</span><strong>{copy.statdCliSpawn}</strong><strong>{copy.statdNativeSpawn}</strong></div>
      <p class="benchmark-note">{copy.statdNote}</p>
    </article>
  </div>

  <div class="proof-block">
    <div class="proof-heading"><span class="section-label">RUNTIME GATES</span><h3>{copy.proofTitle}</h3></div>
    <div class="proof-grid">
      {copy.proofs.map(([title,body]) => <article><strong>{title}</strong><p>{body}</p></article>)}
    </div>
  </div>

  <div class="evidence-links">
    <a href={`${coreRepo}/blob/v0.5.0-beta.1/docs/engineering/beta-readiness-gates.md`} target="_blank" rel="noreferrer">{copy.evidenceLink} ↗</a>
    <a href={`${statdRepo}/tree/cf8843545ea19ecf9a54049e21b2fe609e49d58d/benchmarks/results/phase4-debian13-podman-2026-08-10`} target="_blank" rel="noreferrer">{copy.benchmarkLink} ↗</a>
  </div>
</section>

<section class="capabilities-section technical-frame" id="capabilities" aria-labelledby="capabilities-title">
  <div class="section-intro capability-intro">
    <span class="section-label">{copy.capabilitiesLabel}</span>
    <h2 id="capabilities-title">{copy.capabilitiesTitle}</h2>
    <p>{copy.capabilitiesBody}</p>
  </div>

  <div class="capability-grid">
    {copy.capabilityGroups.map((group) => (
      <article class="capability-card technical-frame">
        <div class="capability-number">{group.number}</div>
        <div class="capability-copy"><h3>{group.title}</h3><p>{group.body}</p></div>
        <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
      </article>
    ))}
  </div>
</section>

<section class="scope-section technical-frame" id="scope" aria-labelledby="scope-title">
  <div class="scope-copy">
