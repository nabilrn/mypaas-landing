---
import BaseLayout from "../layouts/BaseLayout.astro";
import CopyCommand from "./CopyCommand.astro";
import LandingHeader from "./LandingHeader.astro";
import ArchitectureBlueprint from "./compact/ArchitectureBlueprint.astro";
import PixelHeroArt from "./compact/PixelHeroArt.astro";
import TechRail from "./compact/TechRail.astro";
import { siCloudflare, siGithub } from "simple-icons";
import { installCommand, repositoryUrl, type Locale } from "../lib/site";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const path = locale === "en" ? "/" : `/${locale}/`;

const copy = {
  en: {
    title: "MyPaaS — Self-hosted Platform as a Service",
    description: "A self-hosted Platform as a Service for one Linux server with GitHub, Cloudflare, Docker or Podman, Caddy, PostgreSQL, and MCP integration.",
    eyebrow: "SELF-HOSTED PLATFORM AS A SERVICE",
    h1: "Self-hosted Platform as a Service.",
    h1Sub: "For your own Linux server.",
    intro: "You already own the server. MyPaaS gives it the deployment workflow around it: connect GitHub, deploy apps, publish through Cloudflare + Caddy, then operate logs, metrics, databases, recovery, and automation from one place.",
    installLabel: "INSTALL ON UBUNTU / DEBIAN",
    installHint: "Docker default · rootful Podman optional",
    docs: "Read the docs",
    github: "View source",
    facts: ["Ubuntu / Debian Linux", "GitHub OAuth + webhooks", "Cloudflare Tunnel + TLS", "Docker / Podman"],
    integrationEyebrow: "INTEGRATIONS",
    integrationTitle: "Keep the tools already around your server.",
    integrationIntro: "MyPaaS connects the pieces instead of replacing them with a closed runtime. GitHub stays your source workflow, Cloudflare stays your public edge, and standard Linux infrastructure stays underneath.",
    githubTitle: "GitHub is the source workflow.",
    githubBody: "Connect with OAuth, inspect repositories, deploy from Git, and trigger deployments from verified webhooks.",
    cloudflareTitle: "Cloudflare is the public edge.",
    cloudflareBody: "Cloudflare Tunnel exposes the platform without opening inbound ports, while Caddy handles project routing and static delivery on the host.",
    mcpTitle: "Agents can use the same control plane.",
    mcpBody: "The MCP bridge exposes project inspection, deploys, lifecycle actions, rollback, logs, metrics, environment variables, quotas, and host stats to MCP-compatible agent clients.",
    mcpBadge: "MCP / AGENT READY",
    capabilities: [
      ["Deploy", "Git repositories, Dockerfile, Compose, Static / SPA, and public OCI images."],
      ["Operate", "Logs, metrics, lifecycle controls, environment variables, databases, backups, and recovery."],
      ["Automate", "Dashboard for humans, CLI/API for scripts, and MCP tools for agent workflows."],
    ],
    whyEyebrow: "WHY MYPAAS",
    whyTitle: "A modern deployment workflow without giving away the server.",
    whyIntro: "Hosted PaaS gives you convenience by owning the infrastructure. Cluster platforms give you control by asking you to operate much more infrastructure. MyPaaS is deliberately in the middle: one Linux host, standard tools, and a focused control plane.",
    compareHeaders: ["MyPaaS", "Typical hosted PaaS", "Cluster platform"],
    compareRows: [
      ["Infrastructure", "Your Linux host", "Provider-managed", "Your cluster"],
      ["Deployment model", "Single-host PaaS", "Hosted application", "Multi-node orchestration"],
      ["GitHub + Cloudflare", "Part of the workflow", "Provider-dependent", "Integrate separately"],
      ["Agent workflows", "MCP bridge included", "Varies by provider", "Build the integration"],
      ["Runtime", "Docker / Podman + Caddy", "Provider runtime", "Cluster primitives"],
    ],
    howEyebrow: "HOW IT WORKS",
    howTitle: "From repository to a running app.",
    howIntro: "The screenshots below are placeholders. Replace them with verified product captures when the final walkthrough is ready.",
    howSteps: [
      ["01", "Connect your source", "Connect GitHub or start from a public OCI image.", "GitHub connection screenshot"],
      ["02", "Create and deploy", "Choose the detected deployment path, configure the project, and deploy.", "Create project screenshot"],
      ["03", "Publish and operate", "Route the app, then use logs, metrics, lifecycle, recovery, and automation.", "Project operations screenshot"],
    ],
    placeholder: "Screenshot placeholder",
    footer: "Open-source self-hosted PaaS for one Linux host.",
  },
  id: {
    title: "MyPaaS — Platform as a Service self-hosted",
    description: "Platform as a Service self-hosted untuk satu server Linux dengan integrasi GitHub, Cloudflare, Docker atau Podman, Caddy, PostgreSQL, dan MCP.",
    eyebrow: "SELF-HOSTED PLATFORM AS A SERVICE",
    h1: "Platform as a Service yang self-hosted.",
    h1Sub: "Untuk server Linux milikmu sendiri.",
    intro: "Servernya tetap milikmu. MyPaaS menambahkan workflow deployment di atasnya: hubungkan GitHub, deploy aplikasi, publish lewat Cloudflare + Caddy, lalu kelola log, metrik, database, recovery, dan automation dari satu tempat.",
    installLabel: "INSTALL DI UBUNTU / DEBIAN",
    installHint: "Docker default · rootful Podman opsional",
    docs: "Baca dokumentasi",
    github: "Lihat source",
    facts: ["Ubuntu / Debian Linux", "GitHub OAuth + webhooks", "Cloudflare Tunnel + TLS", "Docker / Podman"],
    integrationEyebrow: "INTEGRASI",
    integrationTitle: "Tetap gunakan tools yang sudah ada di sekitar servermu.",
    integrationIntro: "MyPaaS menghubungkan komponen yang sudah kamu pakai, bukan menggantinya dengan runtime tertutup. GitHub tetap menjadi workflow source, Cloudflare tetap menjadi public edge, dan infrastruktur Linux standar tetap berada di bawahnya.",
    githubTitle: "GitHub tetap menjadi source workflow.",
    githubBody: "Hubungkan lewat OAuth, inspeksi repositori, deploy dari Git, dan trigger deployment dari webhook yang terverifikasi.",
    cloudflareTitle: "Cloudflare tetap menjadi public edge.",
    cloudflareBody: "Cloudflare Tunnel mengekspos platform tanpa membuka inbound port, sementara Caddy menangani routing project dan static delivery di host.",
    mcpTitle: "Agent bisa memakai control plane yang sama.",
    mcpBody: "MCP bridge mengekspos inspeksi project, deploy, lifecycle action, rollback, log, metrik, environment variable, quota, dan host stats ke client agent yang kompatibel dengan MCP.",
    mcpBadge: "MCP / AGENT READY",
    capabilities: [
      ["Deploy", "Repositori Git, Dockerfile, Compose, Static / SPA, dan public OCI image."],
      ["Operate", "Log, metrik, lifecycle control, environment variable, database, backup, dan recovery."],
      ["Automate", "Dashboard untuk manusia, CLI/API untuk script, dan MCP tools untuk workflow agent."],
    ],
    whyEyebrow: "KENAPA MYPAAS",
    whyTitle: "Workflow deployment modern tanpa menyerahkan servermu ke platform lain.",
    whyIntro: "Hosted PaaS memberi kemudahan dengan mengelola infrastrukturnya untukmu. Platform cluster memberi kontrol dengan meminta kamu mengoperasikan jauh lebih banyak infrastruktur. MyPaaS sengaja berada di tengah: satu host Linux, tools standar, dan control plane yang fokus.",
    compareHeaders: ["MyPaaS", "Hosted PaaS umum", "Platform cluster"],
    compareRows: [
      ["Infrastruktur", "Host Linux milikmu", "Dikelola provider", "Cluster milikmu"],
      ["Model deployment", "PaaS single-host", "Aplikasi di provider", "Orkestrasi multi-node"],
      ["GitHub + Cloudflare", "Bagian dari workflow", "Tergantung provider", "Integrasi terpisah"],
      ["Workflow agent", "MCP bridge tersedia", "Tergantung provider", "Bangun integrasinya"],
      ["Runtime", "Docker / Podman + Caddy", "Runtime provider", "Primitive cluster"],
    ],
    howEyebrow: "CARA KERJA",
    howTitle: "Dari repositori sampai aplikasi berjalan.",
    howIntro: "Gambar di bawah masih placeholder. Ganti dengan screenshot produk yang sudah diverifikasi saat walkthrough final siap.",
    howSteps: [
      ["01", "Hubungkan source", "Hubungkan GitHub atau mulai dari public OCI image.", "Screenshot koneksi GitHub"],
      ["02", "Buat project dan deploy", "Pilih deployment path yang terdeteksi, konfigurasi project, lalu deploy.", "Screenshot create project"],
      ["03", "Publish dan operasikan", "Route aplikasi, lalu gunakan log, metrik, lifecycle, recovery, dan automation.", "Screenshot operasi project"],
    ],
    placeholder: "Placeholder screenshot",
    footer: "PaaS self-hosted open-source untuk satu host Linux.",
  },
  zh: {
    title: "MyPaaS — 自托管 Platform as a Service",
    description: "面向单台 Linux 服务器的自托管 Platform as a Service，集成 GitHub、Cloudflare、Docker 或 Podman、Caddy、PostgreSQL 与 MCP。",
    eyebrow: "SELF-HOSTED PLATFORM AS A SERVICE",
    h1: "自托管 Platform as a Service。",
    h1Sub: "运行在你自己的 Linux 服务器上。",
    intro: "服务器仍然属于你。MyPaaS 在它之上补齐部署工作流：连接 GitHub、部署应用、通过 Cloudflare + Caddy 发布，并在一个地方管理日志、指标、数据库、恢复与自动化。",
    installLabel: "安装到 UBUNTU / DEBIAN",
    installHint: "默认 Docker · 可选 rootful Podman",
    docs: "阅读文档",
    github: "查看源码",
    facts: ["Ubuntu / Debian Linux", "GitHub OAuth + webhooks", "Cloudflare Tunnel + TLS", "Docker / Podman"],
    integrationEyebrow: "集成",
    integrationTitle: "保留服务器周围已经在使用的工具。",
    integrationIntro: "MyPaaS 负责连接这些组件，而不是用封闭运行时替换它们。GitHub 继续负责源码工作流，Cloudflare 继续作为公共边缘，标准 Linux 基础设施仍在底层。",
    githubTitle: "GitHub 继续负责源码工作流。",
    githubBody: "通过 OAuth 连接、检查仓库、从 Git 部署，并通过已验证 webhook 触发部署。",
    cloudflareTitle: "Cloudflare 继续作为公共边缘。",
    cloudflareBody: "Cloudflare Tunnel 无需开放入站端口即可暴露平台，Caddy 在主机上负责项目路由与静态交付。",
    mcpTitle: "Agent 可以使用同一个控制平面。",
    mcpBody: "MCP bridge 向兼容 MCP 的 agent client 提供项目检查、部署、生命周期、回滚、日志、指标、环境变量、配额与主机状态工具。",
    mcpBadge: "MCP / AGENT READY",
    capabilities: [
      ["部署", "Git 仓库、Dockerfile、Compose、Static / SPA 与公共 OCI 镜像。"],
      ["运维", "日志、指标、生命周期、环境变量、数据库、备份与恢复。"],
      ["自动化", "Dashboard 面向人工，CLI/API 面向脚本，MCP tools 面向 agent workflow。"],
    ],
    whyEyebrow: "为什么选择 MYPAAS",
    whyTitle: "获得现代部署工作流，同时保留自己的服务器。",
    whyIntro: "Hosted PaaS 通过接管基础设施提供便利。集群平台通过要求你运维更多基础设施来提供控制。MyPaaS 刻意位于两者之间：一台 Linux 主机、标准工具和一个聚焦的控制平面。",
    compareHeaders: ["MyPaaS", "典型托管 PaaS", "集群平台"],
    compareRows: [
      ["基础设施", "你的 Linux 主机", "服务商管理", "你的集群"],
      ["部署模型", "单机 PaaS", "托管应用", "多节点编排"],
      ["GitHub + Cloudflare", "工作流的一部分", "取决于服务商", "单独集成"],
      ["Agent workflow", "包含 MCP bridge", "取决于服务商", "自行构建"],
      ["运行时", "Docker / Podman + Caddy", "服务商运行时", "集群原语"],
    ],
    howEyebrow: "工作方式",
    howTitle: "从仓库到运行中的应用。",
    howIntro: "下方图片仍是占位符。最终 walkthrough 准备好后替换为已验证的产品截图。",
    howSteps: [
      ["01", "连接源码", "连接 GitHub 或从公共 OCI 镜像开始。", "GitHub 连接截图"],
      ["02", "创建并部署", "选择检测出的部署路径、配置项目并部署。", "创建项目截图"],
      ["03", "发布并运维", "路由应用，然后使用日志、指标、生命周期、恢复与自动化。", "项目运维截图"],
    ],
    placeholder: "截图占位符",
    footer: "面向单台 Linux 主机的开源自托管 PaaS。",
  },
}[locale];
---
<BaseLayout title={copy.title} description={copy.description} locale={locale} path={path} localizedAlternates>
  <LandingHeader {locale} />
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.h1}<span>{copy.h1Sub}</span></h1>
        <p class="intro">{copy.intro}</p>

        <div class="hero-install">
          <div class="install-head"><span>{copy.installLabel}</span><small>{copy.installHint}</small></div>
          <CopyCommand command={installCommand} label="bootstrap.sh" />
        </div>

        <div class="facts">{copy.facts.map((fact)=><span>{fact}</span>)}</div>
        <div class="actions"><a class="primary" href="/docs/">{copy.docs}</a><a href={repositoryUrl} target="_blank" rel="noreferrer">{copy.github} ↗</a></div>
      </div>
      <PixelHeroArt />
    </section>

    <section class="integration-section">
      <header>
        <p class="section-id">01 / {copy.integrationEyebrow}</p>
        <h2>{copy.integrationTitle}</h2>
        <p>{copy.integrationIntro}</p>
      </header>
      <TechRail />
      <div class="integration-grid">
        <article>
          <div class="integration-icon" style={`--brand:#${siGithub.hex}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg></div>
          <h3>{copy.githubTitle}</h3><p>{copy.githubBody}</p>
        </article>
        <article>
          <div class="integration-icon" style={`--brand:#${siCloudflare.hex}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siCloudflare.path} /></svg></div>
          <h3>{copy.cloudflareTitle}</h3><p>{copy.cloudflareBody}</p>
        </article>
        <article class="agent-card">
          <div class="integration-icon mcp-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.25"/><circle cx="18" cy="6" r="2.25"/><circle cx="18" cy="18" r="2.25"/><path d="M8 11.2 15.7 7M8 12.8l7.7 4.2"/></svg></div>
          <span class="agent-badge">{copy.mcpBadge}</span>
          <h3>{copy.mcpTitle}</h3><p>{copy.mcpBody}</p>
        </article>
      </div>
    </section>

    <ArchitectureBlueprint />

    <section class="capabilities">
      {copy.capabilities.map(([title, body],index)=><article><span>0{index+1}</span><h2>{title}</h2><p>{body}</p></article>)}
    </section>

    <section class="why-section">
      <header><p class="section-id">02 / {copy.whyEyebrow}</p><h2>{copy.whyTitle}</h2><p>{copy.whyIntro}</p></header>
      <div class="comparison" role="table" aria-label="MyPaaS compared with common deployment platform categories">
        <div class="compare-row compare-head" role="row"><span role="columnheader"></span>{copy.compareHeaders.map((item)=><strong role="columnheader">{item}</strong>)}</div>
        {copy.compareRows.map((row)=><div class="compare-row" role="row"><strong role="rowheader">{row[0]}</strong><span role="cell" class="mypaas-cell">{row[1]}</span><span role="cell">{row[2]}</span><span role="cell">{row[3]}</span></div>)}
      </div>
    </section>

    <section class="how-section">
      <header><p class="section-id">03 / {copy.howEyebrow}</p><h2>{copy.howTitle}</h2><p>{copy.howIntro}</p></header>
      <div class="steps-grid">
        {copy.howSteps.map(([index,title,body,placeholder]) => (
          <article class="step-card">
            <div class="shot-placeholder" role="img" aria-label={placeholder}>
              <span>{copy.placeholder}</span><i></i><i></i><i></i><i></i>
            </div>
            <div class="step-copy"><span>{index}</span><strong>{title}</strong><p>{body}</p></div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <footer><span>MyPaaS</span><span>{copy.footer}</span><nav><a href="/docs/">Docs</a><a href={repositoryUrl}>GitHub</a><span>MIT</span></nav></footer>
</BaseLayout>

<style>
.hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(22rem,.92fr);gap:clamp(2rem,5vw,5rem);width:min(calc(100% - 2rem),var(--page-width));margin:0 auto;padding:clamp(3.5rem,7vw,6.2rem) 0 3rem}.eyebrow,.section-id,.install-head span{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;color:var(--app-subtle)}h1,h2,h3{font-family:var(--font-display)}h1{max-width:12ch;margin:.7rem 0 1rem;color:var(--app-ink);font-size:clamp(3.5rem,6.8vw,6.7rem);font-weight:600;line-height:.86;letter-spacing:-.045em}h1 span{display:block;margin-top:.45rem;color:var(--app-muted);font-family:var(--font-sans);font-size:clamp(1.25rem,2.2vw,1.8rem);font-weight:560;line-height:1.15;letter-spacing:-.025em}.intro{max-width:46rem;margin:0;color:var(--app-muted);font-size:clamp(1.02rem,1.35vw,1.18rem);line-height:1.65}.hero-install{position:relative;max-width:50rem;margin-top:1.5rem;padding:.85rem;border:1px solid var(--app-border-strong);background:var(--app-surface)}.hero-install::before{position:absolute;top:-1px;left:-1px;width:9px;height:9px;background:var(--app-ink);box-shadow:10px 0 var(--app-border-strong),20px 0 var(--app-ink);content:""}.install-head{display:flex;justify-content:space-between;gap:1rem;padding:.12rem .08rem .65rem}.install-head small{color:var(--app-muted);font-family:var(--font-mono);font-size:.72rem}.facts{display:flex;flex-wrap:wrap;gap:.45rem .65rem;margin-top:1rem}.facts span{padding:.32rem .5rem;border:1px solid var(--app-border);background:var(--app-surface);color:var(--app-muted);font-size:.82rem}.actions{display:flex;gap:.7rem;margin-top:1.15rem}.actions a{display:inline-flex;align-items:center;min-height:2.65rem;padding:.62rem .9rem;border:1px solid var(--app-border-strong);color:var(--app-ink);font-size:.86rem;font-weight:620;text-decoration:none}.actions a.primary{background:var(--app-ink);color:var(--app-bg)}
.integration-section,.why-section,.how-section{width:min(calc(100% - 2rem),var(--page-width));margin:0 auto;padding:3rem 0;border-top:1px solid var(--app-border-strong)}.integration-section>header,.why-section>header,.how-section>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.72fr);gap:.7rem 3.5rem;align-items:end;margin-bottom:1.6rem}.section-id{grid-column:1/-1;margin:0}.integration-section h2,.why-section h2,.how-section h2{max-width:17ch;margin:0;color:var(--app-ink);font-size:clamp(2.2rem,4.2vw,4rem);font-weight:560;line-height:.94;letter-spacing:-.035em}.integration-section>header>p:last-child,.why-section>header>p:last-child,.how-section>header>p:last-child{margin:0;color:var(--app-muted);font-size:1rem;line-height:1.6}.integration-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:1.25rem;border:1px solid var(--app-border-strong);background:var(--app-border)}.integration-grid article{position:relative;min-height:15rem;padding:1.35rem;background:var(--app-surface)}.integration-icon{display:grid;width:2.9rem;height:2.9rem;margin-bottom:1.25rem;border:1px solid var(--app-border-strong);background:var(--app-bg);place-items:center}.integration-icon svg{width:1.45rem;height:1.45rem;fill:var(--brand)}.integration-icon.mcp-icon svg{fill:none;stroke:var(--app-ink);stroke-width:1.65;stroke-linecap:square}.integration-grid h3{max-width:16ch;margin:0;color:var(--app-ink);font-size:1.65rem;font-weight:560;line-height:1}.integration-grid article>p{margin:.75rem 0 0;color:var(--app-muted);font-size:.94rem;line-height:1.58}.agent-card::before{position:absolute;right:0;top:0;width:32px;height:32px;background:var(--app-ink);clip-path:polygon(50% 0,100% 0,100% 50%,75% 50%,75% 75%,50% 75%,50% 100%,25% 100%,25% 50%,0 50%,0 25%,50% 25%);content:""}.agent-badge{display:inline-block;margin:-.25rem 0 .8rem;color:var(--app-subtle);font-family:var(--font-mono);font-size:.68rem;letter-spacing:.08em}
.capabilities{display:grid;grid-template-columns:repeat(3,1fr);width:min(calc(100% - 2rem),var(--page-width));margin:0 auto;padding:2rem 0 3rem}.capabilities article{padding:1.2rem 1.4rem 1.25rem 0;border-right:1px solid var(--app-border)}.capabilities article+article{padding-left:1.4rem}.capabilities article:last-child{border-right:0}.capabilities span{color:var(--app-subtle);font-family:var(--font-mono);font-size:.72rem}.capabilities h2{margin:.35rem 0 .55rem;color:var(--app-ink);font-size:1.8rem;font-weight:560}.capabilities p{margin:0;color:var(--app-muted);font-size:.94rem;line-height:1.55}
.comparison{overflow-x:auto;border:1px solid var(--app-border-strong);background:var(--app-surface)}.compare-row{display:grid;grid-template-columns:minmax(9rem,.72fr) repeat(3,minmax(11rem,1fr));border-bottom:1px solid var(--app-border)}.compare-row:last-child{border-bottom:0}.compare-row>*{min-width:0;padding:.78rem .85rem;border-right:1px solid var(--app-border);font-size:.82rem;line-height:1.45}.compare-row>*:last-child{border-right:0}.compare-head>*{color:var(--app-subtle);font-family:var(--font-mono);font-size:.7rem;letter-spacing:.04em;text-transform:uppercase}.compare-row>strong:first-child{color:var(--app-ink)}.compare-row>span{color:var(--app-muted)}.mypaas-cell{position:relative;background:var(--app-surface-muted);color:var(--app-ink)!important;font-weight:620}.mypaas-cell::before{position:absolute;top:0;left:0;width:5px;height:5px;background:var(--app-ink);content:""}
