---
interface CommandTab {
  id: string;
  tab: string;
  lines: readonly string[];
  steps: readonly string[];
}

interface Props {
  tabs: readonly CommandTab[];
  copyLabel?: string;
  copiedLabel?: string;
  failedLabel?: string;
}

const {
  tabs,
  copyLabel = "Copy",
  copiedLabel = "Copied",
  failedLabel = "Copy failed",
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
const commands = tabs.map((tab) => tab.lines.join(" && "));
---

<div
  class="command-tabs"
  data-command-tabs
  data-commands={JSON.stringify(commands)}
  data-copy-default={copyLabel}
  data-copy-success={copiedLabel}
  data-copy-failed={failedLabel}
>
  <div class="command-meta">
    <div class="command-tablist" role="tablist">
      {tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-tab-${tab.id}`}
          aria-controls={`${uid}-panel-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          data-tab-button={index}
        >
          {tab.tab}
        </button>
      ))}
    </div>
    <button type="button" class="command-copy" data-copy-button aria-label="Copy command">
      <span class="copy-state" aria-hidden="true" data-copy-state></span>
      <span data-copy-label>{copyLabel}</span>
    </button>
  </div>

  {tabs.map((tab, index) => (
    <div
      class="command-panel"
      role="tabpanel"
      id={`${uid}-panel-${tab.id}`}
      aria-labelledby={`${uid}-tab-${tab.id}`}
      hidden={index !== 0}
      data-tab-panel={index}
    >
      <pre><code>{tab.lines.map((line) => (
        <span class="command-line"><span class="prompt" aria-hidden="true">$</span> <span class="command-main">{line}</span></span>
      ))}</code></pre>
      <ul class="command-steps">
        {tab.steps.map((step) => <li><span class="step-marker" aria-hidden="true">✓</span>{step}</li>)}
      </ul>
    </div>
  ))}

  <p class="copy-feedback" role="status" aria-live="polite" data-copy-feedback></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-command-tabs]:not([data-tabs-ready])").forEach((box) => {
    box.dataset.tabsReady = "true";
    const buttons = Array.from(box.querySelectorAll<HTMLButtonElement>("[data-tab-button]"));
    const panels = Array.from(box.querySelectorAll<HTMLElement>("[data-tab-panel]"));
    const copyButton = box.querySelector<HTMLButtonElement>("[data-copy-button]");
    const copyText = box.querySelector<HTMLElement>("[data-copy-label]");
    const feedback = box.querySelector<HTMLElement>("[data-copy-feedback]");
    const state = box.querySelector<HTMLElement>("[data-copy-state]");
    let commands: string[] = [];
    let active = 0;
    let timer: number | undefined;

    try {
      commands = JSON.parse(box.dataset.commands ?? "[]");
    } catch {
      commands = [];
    }

    const activate = (index: number, focus = false) => {
      active = index;
      buttons.forEach((button, i) => {
        button.setAttribute("aria-selected", i === index ? "true" : "false");
        if (focus && i === index) button.focus();
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    };

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => activate(index));
      button.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const delta = event.key === "ArrowRight" ? 1 : -1;
        activate((active + delta + buttons.length) % buttons.length, true);
      });
    });

    const setState = (text: string, mode: "idle" | "success" | "error") => {
      if (copyText) copyText.textContent = text;
      if (feedback) feedback.textContent = mode === "idle" ? "" : text;
      if (state) state.dataset.state = mode;
      box.dataset.copyStatus = mode;
    };

    copyButton?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(commands[active] ?? "");
        setState(box.dataset.copySuccess || "Copied", "success");
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          setState(box.dataset.copyDefault || "Copy", "idle");
        }, 1800);
      } catch {
        setState(box.dataset.copyFailed || "Copy failed", "error");
      }
    });
  });
</script>

<style>
  .command-tabs {
    position: relative;
    overflow: hidden;
    border: 1px solid oklch(0.32 0.016 255);
    border-radius: 0.48rem;
    background: oklch(0.145 0.012 255);
    color: oklch(0.92 0.014 165);
    box-shadow: 0 16px 40px rgb(15 23 42 / 0.12);
  }

  .command-tabs::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(90deg, rgb(16 185 129 / 0.08), transparent 38%),
      repeating-linear-gradient(90deg, transparent 0 5.75rem, rgb(255 255 255 / 0.035) 5.75rem 5.8rem);
  }

  .command-meta {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.65rem;
    padding-inline: 0.55rem 0.85rem;
    border-bottom: 1px solid oklch(0.3 0.016 255);
  }

  .command-tablist {
    display: inline-flex;
    gap: 0.25rem;
  }

  [role="tab"] {
    padding: 0.32rem 0.6rem;
    border: 1px solid transparent;
    border-radius: 0.3rem;
    background: transparent;
    color: oklch(0.62 0.014 255);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    cursor: pointer;
  }

  [role="tab"]:hover {
    color: oklch(0.82 0.014 255);
  }

  [role="tab"][aria-selected="true"] {
    border-color: oklch(0.36 0.018 255);
    background: oklch(0.21 0.014 255);
    color: oklch(0.82 0.13 165);
  }

  [role="tab"]:focus-visible,
  .command-copy:focus-visible {
    outline: 2px solid oklch(0.72 0.15 165);
    outline-offset: 2px;
  }

  .command-copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid oklch(0.36 0.018 255);
    border-radius: 0.3rem;
    background: oklch(0.21 0.014 255);
    color: oklch(0.82 0.13 165);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    cursor: pointer;
  }

  .command-copy:hover {
    border-color: oklch(0.58 0.15 165);
  }

  .copy-state {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: oklch(0.58 0.014 255);
  }

  .copy-state[data-state="success"] {
    background: oklch(0.72 0.15 165);
    box-shadow: 0 0 0 4px rgb(16 185 129 / 0.13);
  }

  .copy-state[data-state="error"] {
    background: oklch(0.65 0.2 25);
  }

  .command-panel pre {
    position: relative;
    margin: 0;
    overflow-x: auto;
    padding: 0.95rem 1rem 0.35rem;
    font-size: 0.78rem;
    line-height: 1.65;
    white-space: pre;
  }

  .command-line {
    display: block;
  }

  .prompt {
    color: oklch(0.72 0.15 165);
  }

  .command-main {
    color: oklch(0.92 0.02 155);
    font-weight: 500;
  }

  .command-steps {
    position: relative;
    display: grid;
    gap: 0.42rem;
    margin: 0;
    padding: 0.55rem 1rem 1.05rem;
    list-style: none;
  }

  .command-steps li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: oklch(0.66 0.014 255);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .step-marker {
    flex: 0 0 auto;
    color: oklch(0.72 0.15 165);
    font-size: 0.66rem;
  }

  .copy-feedback {
    position: absolute;
    right: 0.85rem;
    bottom: 0.45rem;
    margin: 0;
    color: oklch(0.72 0.15 165);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  @media (max-width: 560px) {
    .command-panel pre {
      font-size: 0.7rem;
    }

    .copy-feedback {
      position: static;
      padding: 0 0.85rem 0.65rem;
    }
  }
</style>
