---
const { copy } = Astro.props;
---
<section id="operations"><p class="label">{copy.operationsLabel}</p><h2>{copy.operationsTitle}</h2><p>{copy.operationsBody}</p><ol>{copy.operations.map((item) => <li><strong>{item[0]}</strong><span>{item[1]}</span></li>)}</ol></section>
<style>
section{padding:5rem 1rem}section>*{max-width:76rem;margin-left:auto;margin-right:auto}.label{font-family:var(--font-mono);color:var(--app-subtle)}h2{font-size:3rem;letter-spacing:-.05em}p,span{color:var(--app-muted)}ol{padding:0;list-style:none}li{display:grid;grid-template-columns:9rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--app-border)}
</style>
