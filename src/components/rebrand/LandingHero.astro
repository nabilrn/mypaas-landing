---
import TechLabel from "../pixel/TechLabel.astro";
interface Props { title: string; body: string; eyebrow: string; primary: string; secondary: string; repositoryUrl: string; proof: readonly string[] }
const { title, body, eyebrow, primary, secondary, repositoryUrl, proof } = Astro.props;
---
<section class="hero">
  <TechLabel label={eyebrow} />
  <h1>{title}</h1>
  <p class="lead">{body}</p>
  <div class="actions"><a class="primary" href="/docs/installation/">{primary}</a><a class="secondary" href={repositoryUrl} target="_blank" rel="noreferrer">{secondary}<span aria-hidden="true">↗</span></a></div>
  <ul class="proof" aria-label="MyPaaS platform summary">{proof.map((item)=><li>{item}</li>)}</ul>
</section>
<style>
.hero{padding:clamp(5rem,9vw,8rem) 0 clamp(3rem,6vw,5rem)}h1{max-width:11ch;margin:1.35rem 0 1.4rem;color:var(--app-ink);font-size:clamp(3rem,6vw,5.25rem);font-weight:630;letter-spacing:-.038em;line-height:.97;text-wrap:balance}.lead{max-width:43rem;margin:0;color:var(--app-body);font-size:clamp(1.03rem,1.5vw,1.14rem);line-height:1.62}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.actions a{display:inline-flex;min-height:2.8rem;align-items:center;justify-content:center;gap:.45rem;padding:.65rem 1rem;border:1px solid var(--app-border-strong);color:var(--app-ink);font-size:.82rem;font-weight:600;text-decoration:none;clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px)}.actions .primary{border-color:var(--app-ink);background:var(--app-ink);color:var(--app-bg)}.actions .secondary:hover{background:var(--app-surface-muted)}.proof{display:flex;flex-wrap:wrap;gap:.45rem 1rem;margin:2.25rem 0 0;padding:1.25rem 0 0;border-top:1px solid var(--app-border);list-style:none}.proof li{position:relative;padding-left:.75rem;color:var(--app-subtle);font-family:var(--font-mono);font-size:.64rem;letter-spacing:.03em}.proof li::before{position:absolute;top:.36rem;left:0;width:4px;height:4px;background:var(--app-ink);content:""}
@media(max-width:600px){.hero{padding-top:4.5rem}h1{font-size:clamp(2.7rem,14vw,4rem);letter-spacing:-.034em}.lead{font-size:1rem}.actions{display:grid;grid-template-columns:1fr 1fr}.proof{gap:.65rem 1rem}}
@media(max-width:360px){.actions{grid-template-columns:1fr}}
</style>
