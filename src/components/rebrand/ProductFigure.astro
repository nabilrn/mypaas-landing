---
import PixelFrame from "../pixel/PixelFrame.astro";
interface Props { src: string; alt: string; label: string; detail?: string; eager?: boolean; dither?: boolean }
const { src, alt, label, detail = "REAL PRODUCT UI", eager = false, dither = false } = Astro.props;
---
<PixelFrame {label} {detail} {dither}>
  <img {src} {alt} decoding="async" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} />
</PixelFrame>
<style>img{display:block;width:100%;height:auto;background:var(--app-surface)}</style>
