---
interface Props { label?: string; detail?: string; dither?: boolean; class?: string }
const { label, detail, dither = false, class: className = "" } = Astro.props;
---
<figure class:list={["pixel-frame", { dither }, className]}>
  {(label || detail) && <figcaption><span>{label}</span><span>{detail}</span></figcaption>}
  <div class="pixel-frame__content"><slot /></div>
</figure>
<style>
.pixel-frame{position:relative;margin:0;border:1px solid var(--app-border-strong);background:var(--app-surface);clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px)}.pixel-frame::before,.pixel-frame::after{position:absolute;z-index:2;width:9px;height:9px;content:"";pointer-events:none}.pixel-frame::before{top:-1px;left:-1px;border-top:1px solid var(--app-bg);border-left:1px solid var(--app-bg);background:var(--app-bg)}.pixel-frame::after{right:-1px;bottom:-1px;border-right:1px solid var(--app-bg);border-bottom:1px solid var(--app-bg);background:var(--app-bg)}figcaption{display:flex;justify-content:space-between;gap:1rem;padding:.7rem .85rem;border-bottom:1px solid var(--app-border);color:var(--app-subtle);font-family:var(--font-mono);font-size:.64rem;letter-spacing:.04em}.pixel-frame__content{position:relative;overflow:hidden}.dither{box-shadow:14px 14px 0 var(--app-dither)}@media(max-width:600px){figcaption{display:grid;gap:.2rem}.dither{box-shadow:8px 8px 0 var(--app-dither)}}
</style>
