---
interface Props { label: string; index?: string }
const { label, index } = Astro.props;
---
<p class="tech-label">{index && <span>{index}</span>}<strong>{label}</strong></p>
<style>
.tech-label{display:flex;align-items:center;gap:.6rem;margin:0;color:var(--app-subtle);font-family:var(--font-mono);font-size:.68rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase}.tech-label span{display:grid;width:1.45rem;height:1.45rem;place-items:center;border:1px solid var(--app-border-strong);color:var(--app-ink);font-size:.58rem}.tech-label strong{font:inherit}
</style>
