---
interface Props {
  lightSrc?: string;
  darkSrc?: string;
  lightAlt?: string;
  darkAlt?: string;
  compareLabel?: string;
  privacyLabel?: string;
}

const {
  lightSrc = "/landing/mypaas_dashboard_light.webp",
  darkSrc = "/landing/mypaas_dashboard_dark.webp",
  lightAlt = "MyPaaS projects dashboard in light mode",
  darkAlt = "MyPaaS projects dashboard in dark mode",
  compareLabel = "Compare light and dark MyPaaS dashboard themes",
  privacyLabel = "Account details hidden",
} = Astro.props;
---

<figure class="compare-shell technical-frame" aria-label={compareLabel} data-compare-shell>
  <div class="compare-stage" style="--reveal: 50%" data-compare-stage>
    <img
      class="compare-image compare-image-light"
      src={lightSrc}
      alt={lightAlt}
      width="1858"
      height="914"
      loading="lazy"
      decoding="async"
      draggable="false"
    />
    <img
      class="compare-image compare-image-dark"
      src={darkSrc}
      alt={darkAlt}
      width="1858"
      height="914"
      loading="lazy"
      decoding="async"
      draggable="false"
    />

    <input
      class="compare-input"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label={compareLabel}
      aria-valuetext="50% dark theme shown"
      data-compare-input
    />

    <div class="compare-divider" aria-hidden="true"></div>
    <div class="compare-handle" aria-hidden="true"><span>←</span><span>→</span></div>

    <div class="theme-label theme-label-light" aria-hidden="true">LIGHT</div>
    <div class="theme-label theme-label-dark" aria-hidden="true">DARK</div>

    <div class="privacy-mask" aria-hidden="true"><span>{privacyLabel}</span></div>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-compare-shell]").forEach((shell) => {
    const stage = shell.querySelector<HTMLElement>("[data-compare-stage]");
    const input = shell.querySelector<HTMLInputElement>("[data-compare-input]");
    let frameId: number | null = null;
    let timer: number | null = null;
    let animating = false;

    const setPosition = (position: number) => {
      stage?.style.setProperty("--reveal", `${position}%`);
      if (input) {
        input.value = String(position);
        input.setAttribute("aria-valuetext", `${Math.round(position)}% dark theme shown`);
      }
    };

    const stop = () => {
      animating = false;
      if (frameId !== null) cancelAnimationFrame(frameId);
      if (timer !== null) clearTimeout(timer);
      frameId = null;
      timer = null;
    };

    const ease = (value: number) => value < .5
      ? 2 * value * value
      : 1 - Math.pow(-2 * value + 2, 2) / 2;

    const demo = () => {
      stop();
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      animating = true;
      const startedAt = performance.now();
      const tick = (now: number) => {
        if (!animating) return;
        const progress = Math.min((now - startedAt) / 1450, 1);
        const position = progress <= .66
          ? 28 + 44 * ease(progress / .66)
          : 72 - 22 * ease((progress - .66) / .34);
        setPosition(position);
        if (progress < 1) frameId = requestAnimationFrame(tick);
        else { stop(); setPosition(50); }
      };
      frameId = requestAnimationFrame(tick);
    };

    input?.addEventListener("input", () => { stop(); setPosition(Number(input.value)); });
    input?.addEventListener("pointerdown", stop);
    input?.addEventListener("keydown", stop);
    timer = window.setTimeout(demo, 650);
  });
</script>

<style>
.compare-shell{margin:0;overflow:hidden;border:1px solid #cfcfcf;background:#fff}
.compare-stage{position:relative;isolation:isolate;aspect-ratio:1858/914;overflow:hidden;background:#090909;user-select:none}
.compare-image{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:left top;pointer-events:none}
.compare-image-dark{clip-path:inset(0 calc(100% - var(--reveal)) 0 0)}
.compare-input{position:absolute;z-index:8;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize;touch-action:pan-y}
.compare-divider{position:absolute;z-index:5;top:0;bottom:0;left:var(--reveal);width:1px;background:#fff;box-shadow:0 0 0 1px rgb(0 0 0/.35);transform:translateX(-50%);pointer-events:none}
.compare-handle{position:absolute;z-index:9;top:50%;left:clamp(1.5rem,var(--reveal),calc(100% - 1.5rem));display:flex;width:3rem;height:3rem;align-items:center;justify-content:center;gap:.28rem;border:1px solid #fff;background:#090909;color:#fff;font-family:var(--font-mono);font-size:.68rem;transform:translate(-50%,-50%);pointer-events:none}
.compare-input:focus-visible~.compare-handle{outline:3px solid #fff;outline-offset:3px}
.theme-label{position:absolute;z-index:6;top:14px;padding:5px 8px;border:1px solid rgb(127 127 127/.55);background:rgb(255 255 255/.88);color:#111;font-family:var(--font-mono);font-size:.62rem;font-weight:700;letter-spacing:.09em;pointer-events:none}.theme-label-light{right:14px}.theme-label-dark{left:14px;background:rgb(10 10 10/.88);color:#fff}
.privacy-mask{position:absolute;z-index:7;left:0;bottom:0;display:flex;width:13.75%;height:14.8%;align-items:center;justify-content:center;border-top:1px solid rgb(127 127 127/.32);border-right:1px solid rgb(127 127 127/.32);background:rgb(18 18 18/.54);backdrop-filter:blur(16px);pointer-events:none}.privacy-mask span{padding:.3rem .42rem;border:1px solid rgb(255 255 255/.25);background:rgb(0 0 0/.76);color:#fff;font-family:var(--font-mono);font-size:clamp(.34rem,.48vw,.58rem);line-height:1.15;text-align:center}
@media(max-width:720px){.compare-stage{aspect-ratio:4/3}.compare-image{width:auto;min-width:100%;height:100%;object-position:20% top}.privacy-mask{width:20%;height:13%}.compare-handle{width:2.6rem;height:2.6rem}.theme-label{top:9px}.theme-label-light{right:9px}.theme-label-dark{left:9px}}
</style>
