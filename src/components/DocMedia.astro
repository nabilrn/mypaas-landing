---
import { Image } from "astro:assets";
type ImageLike = string | { src: string; width?: number; height?: number };
interface Props { src?: ImageLike; alt?: string; title: string; source?: string; note?: string; placeholder?: string }
const { src, alt = "", title, source = "MyPaaS", note, placeholder } = Astro.props;
const isObject = typeof src === "object" && src !== null;
const imageSrc = isObject ? src.src : src;
const width = isObject ? src.width : undefined;
const height = isObject ? src.height : undefined;
---
<figure class:list={["doc-media", { placeholder: !imageSrc }]}>
  <figcaption><span><strong>{title}</strong>{source && <small>{source}</small>}</span>{note && <small>{note}</small>}</figcaption>
  {imageSrc ? (
    isObject ? (
      <Image src={src as any} {alt} loading="lazy" decoding="async" />
    ) : (
      <img src={imageSrc} {alt} {width} {height} loading="lazy" decoding="async" />
    )
  ) : (
    <div class="placeholder-body" role="img" aria-label={`${title} screenshot placeholder`}>
      <div class="placeholder-frame" aria-hidden="true"><i></i><i></i><i></i><div></div></div>
      <strong>Screenshot placeholder</strong><p>{placeholder ?? "Replace with a verified screenshot during the documentation capture pass."}</p>
    </div>
  )}
</figure>
<style>
.doc-media{margin:1.5rem 0;overflow:hidden;border:1px solid var(--app-border-strong);background:var(--app-surface);clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px)}figcaption{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;padding:.7rem .85rem;border-bottom:1px solid var(--app-border);color:var(--app-muted)}figcaption span{display:grid;gap:.15rem}figcaption strong{color:var(--app-ink);font-size:.76rem;font-weight:600}figcaption small{color:var(--app-subtle);font-family:var(--font-mono);font-size:.61rem;letter-spacing:.03em}img{display:block;width:100%;height:auto}.placeholder-body{display:grid;place-items:center;min-height:17rem;padding:2rem;text-align:center;background-color:var(--app-surface-muted);background-image:url('/patterns/dither-25.svg')}.placeholder-body>strong{margin-top:1rem;color:var(--app-ink);font-size:.84rem}.placeholder-body p{max-width:34rem;margin:.35rem 0 0;color:var(--app-muted);font-size:.78rem;line-height:1.6}.placeholder-frame{display:grid;grid-template-columns:repeat(3,6px) 1fr;align-items:center;gap:5px;width:min(100%,28rem);height:9rem;padding:.7rem;border:1px solid var(--app-border-strong);background:var(--app-surface)}.placeholder-frame>i{width:6px;height:6px;background:var(--app-border-strong)}.placeholder-frame>div{grid-column:1/-1;align-self:stretch;margin-top:.2rem;border-top:1px solid var(--app-border);background:var(--app-surface-muted)}@media(max-width:640px){figcaption{display:grid}.placeholder-body{min-height:14rem}}
</style>
