---
type ImageLike = string | { src: string; width?: number; height?: number };
interface Props { src?: ImageLike; alt?: string; title: string; source?: string; note?: string; placeholder?: string }
const { src, alt = "", title, source = "MyPaaS", note, placeholder } = Astro.props;
const imageSrc = typeof src === "string" ? src : src?.src;
const width = typeof src === "string" ? undefined : src?.width;
const height = typeof src === "string" ? undefined : src?.height;
---
<figure class:list={["doc-media", { placeholder: !imageSrc }]}>
  <figcaption><span><strong>{title}</strong>{source && <small>{source}</small>}</span>{note && <small>{note}</small>}</figcaption>
  {imageSrc ? <img src={imageSrc} {alt} {width} {height} loading="lazy" decoding="async" /> : <div class="placeholder-body" role="img" aria-label={`${title} screenshot placeholder`}><strong>Screenshot placeholder</strong><p>{placeholder ?? "Replace with a verified screenshot during the documentation capture pass."}</p></div>}
</figure>
<style>.doc-media{margin:1.5rem 0;overflow:hidden;border:1px solid var(--app-border);border-radius:.5rem;background:var(--app-surface)}figcaption{display:flex;justify-content:space-between;gap:1rem;padding:.75rem .9rem;border-bottom:1px solid var(--app-border);color:var(--app-muted)}figcaption span{display:grid;gap:.15rem}small{color:var(--app-subtle);font-family:var(--font-mono);font-size:.62rem}img{display:block;width:100%;height:auto}.placeholder-body{display:grid;place-items:center;min-height:16rem;padding:2rem;text-align:center;background:var(--app-surface-muted)}.placeholder-body p{max-width:34rem;color:var(--app-muted)}</style>
