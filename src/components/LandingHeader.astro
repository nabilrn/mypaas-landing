---
import SearchDialog from "./SearchDialog.astro";
import { localeMeta, locales, repositoryUrl, uiCopy, type Locale } from "../lib/site";
const { locale = "en" } = Astro.props as { locale?: Locale };
const copy = uiCopy[locale];
---
<header class="site-header">
  <a class="brand" href={localeMeta[locale].path} aria-label={copy.home}><img src="/brand/logowithtext_black.png" alt="MyPaaS" /></a>
  <nav aria-label={copy.navLabel}><a href="/docs/">{copy.docs}</a><a href="/docs/installation/">{copy.install}</a><a href={repositoryUrl} target="_blank" rel="noreferrer">GitHub</a></nav>
  <div class="header-tools">
    <button class="search-button" data-search-trigger aria-label={copy.searchOpen}>{copy.search}</button>
    <details class="language"><summary aria-label={copy.language}>{localeMeta[locale].short}</summary><div>{locales.map((item)=><a href={localeMeta[item].path} aria-current={item===locale?"page":undefined}>{localeMeta[item].short}</a>)}</div></details>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={copy.themeDark}><span aria-hidden="true"></span></button>
  </div>
</header>
<SearchDialog {locale} />
<script is:inline define:vars={{ darkLabel: copy.themeDark, lightLabel: copy.themeLight }}>
(()=>{const button=document.querySelector('[data-theme-toggle]');if(!(button instanceof HTMLButtonElement))return;const sync=()=>{const dark=document.documentElement.classList.contains('dark');button.setAttribute('aria-label',dark?lightLabel:darkLabel);button.dataset.mode=dark?'dark':'light'};button.addEventListener('click',()=>{const dark=!document.documentElement.classList.contains('dark');document.documentElement.classList.toggle('dark',dark);localStorage.setItem('mypaas-theme',dark?'dark':'light');sync()});sync()})();
</script>
<style>
.site-header{position:relative;z-index:20;display:flex;min-height:4.25rem;align-items:center;gap:1.5rem;padding:0 max(1rem,calc((100% - var(--page-width))/2));border-bottom:1px solid var(--app-border);background:color-mix(in srgb,var(--app-bg) 94%,transparent)}.brand{margin-right:auto}.brand img{width:6.8rem;height:auto}:global(.dark) .brand img{filter:invert(1)}nav{display:flex;align-items:center;gap:1.25rem}.site-header a,.site-header button,.site-header summary{color:var(--app-muted);font-size:.78rem;font-weight:560;text-decoration:none}.site-header a:hover,.site-header button:hover,.site-header summary:hover{color:var(--app-ink)}.header-tools{display:flex;align-items:center;gap:.35rem}.search-button,.theme-toggle,.language summary{min-height:2rem;border:1px solid transparent;background:transparent;cursor:pointer}.search-button{padding:0 .45rem}.theme-toggle{display:grid;width:2rem;padding:0;place-items:center}.theme-toggle span{position:relative;width:10px;height:10px;border:1px solid var(--app-ink)}.theme-toggle[data-mode="dark"] span{background:var(--app-ink)}.language{position:relative}.language summary{display:grid;padding:0 .45rem;place-items:center;list-style:none;cursor:pointer}.language summary::-webkit-details-marker{display:none}.language div{position:absolute;top:calc(100% + .45rem);right:0;display:grid;min-width:4.4rem;border:1px solid var(--app-border-strong);background:var(--app-surface)}.language div a{padding:.55rem .7rem;font-family:var(--font-mono);font-size:.66rem}.language div a[aria-current="page"]{background:var(--app-ink);color:var(--app-bg)}
@media(max-width:720px){.site-header{gap:.6rem;min-height:3.8rem}.brand img{width:5.9rem}nav{gap:.75rem}nav a:nth-child(2){display:none}.search-button{font-size:0}.search-button::before{content:"/";font-family:var(--font-mono);font-size:.8rem}.header-tools{gap:.15rem}}
@media(max-width:420px){nav a:first-child{display:none}.site-header{padding-inline:.75rem}}
</style>
